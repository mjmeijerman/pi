#!/usr/bin/env bash
# space — the durable project spaces, and the only command the UI calls.
#
#   bin/space new [<slug>] [--project PATH | --here | --clone URL] [--kind harness|project]
#                  [--no-git] [--tab-name Boss] [--argv JSON]
#   bin/space new              (on a terminal: ask for the name and the folder, with defaults)
#   bin/space list [--json]
#   bin/space show <slug>
#   bin/space policy <slug> [--max-open-prs <n|unbounded>] [--json]
#   bin/space move <slug> --project PATH [--json]
#   bin/space forget <slug> [--yes]
#   bin/space tab forget <slug> <name> [--json]
#   bin/space tab list <slug> [--json]
#
# A space is one project. It is durable: the record at state/spaces/<slug>/space.json outlives
# the terminals in it, so later workers can reopen the tabs and read where the work goes. The
# record carries herdr's id for the space (`id`), because a worker is opened as a tab inside it
# and `tab.new` takes that id; a record from before the field is filled in by `delegate` from
# `herdr-app ls`, by name, once.
#
# `kind` says what learning in the space may change, and the space decides it, never the session
# that compacted: a `harness` space is this pi checkout and its learner may edit the harness and
# publish its own branch; a `project` space (the default, and what a record without the field
# reads as) teaches that project's `AGENTS.md` and nothing else. One harness space per machine:
# a second one would be a second copy of the harness to disagree with the first.
# `bin/delegate` reads the space from the directory it is run in, and refuses in a folder no
# space claims — creating one here is the fix that refusal names.
#
# The project's AGENTS.md gets one block between two markers (agent/space-rules.md): one project
# per space, another project's work is answered with the command to run in its space, one worker
# at a time, merged before the next. Replacing means a re-run never grows a second copy.
#
# `max_open_prs` is how many of the space's pull requests may be open at once: an integer of 1 or
# more, or `unbounded`. Absent means 1, which is the merged-before-the-next rule every record was
# made under, so a space that wants several open at once says so in its own record rather than
# every space loosening the rule. `bin/space policy` reads it and writes only that field.
#
# `forget` drops the record and nothing else, so it asks for the space's name typed back after
# saying what goes and what stays: a `y` is an answer to a question nobody read.
#
# `tab forget` edits the record's `tabs[]` list, and that is the whole mechanism: `bin/guard`
# rebuilds a space that is gone from every entry in `tabs[]`, so a tab a person closed comes back
# after a reboot until its entry is gone. The verb never talks to herdr — it removes an entry from
# a file — so no app running is not a failure here, and the tab that is open right now is not
# closed by it either.
set -euo pipefail

here=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)
# shellcheck source=bin/shell-resolve.sh
if [ -f "$here/shell-resolve.sh" ]; then . "$here/shell-resolve.sh"; fi
# shellcheck source=bin/space-lib.sh
. "$here/space-lib.sh"

# The Boss is bare: `bin/pi-bare` in this tree, never a sandboxed wrapper. Workers are sandboxed,
# the Boss is not, and a record that says otherwise brings a sandboxed Boss back after every reboot.
pi_home=$(cd -- "$here/.." && pwd)
pi_bare=$pi_home/bin/pi-bare

prog=space
die() { printf '%s: error: %s\n' "$prog" "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is not on PATH"; }

usage() {
	cat >&2 <<'EOF'
usage: bin/space new [<slug>] [--project PATH | --here | --clone URL] [--kind harness|project] [--no-git] [--tab-name Boss] [--argv JSON]
       bin/space new            (on a terminal: asks name, where (a folder, or a URL to clone),
                                "create it?" when the folder is not there, and whether it is a git
                                project; with nothing to read it prints this and exits 1, the
                                script path)
       The name is the one positional: `bin/space new demo` in a project folder means --project $PWD.
       --argv is the Boss tab's command as a JSON array (default ["<pi home>/bin/pi-bare"]); it is
       opened with it and the record keeps it, so the guard reopens the same command. The Boss is
       bare: an --argv naming pi, pisandbox or pi-sandboxed is refused.
       bin/space list [--json]
       bin/space show <slug>
       bin/space policy <slug> [--max-open-prs <n|unbounded>] [--json]
       bin/space move <slug> --project PATH [--json]
       bin/space forget <slug> [--yes]
       bin/space tab forget <slug> <name> [--json]
       bin/space tab list <slug> [--json]

bin/space policy prints a space's max_open_prs (1 (default) when the record has none; an
integer of 1 or more, or unbounded) and, with --max-open-prs, writes that field and nothing
else. bin/space forget asks for the space's name typed back before it drops the record; --yes
answers it up front for a script and prints the same explanation to stderr.
bin/space tab forget removes one entry from the record's tabs list, which is what bin/guard
rebuilds a space from: a tab closed there stays closed. It edits the record and never talks to
herdr, refuses the Boss tab (bin/space forget <slug> is the way to drop a whole space), refuses a
name no entry matches (naming the entries there are) and refuses a tab a tracked worker is using
(bin/delegate close <slug>). bin/space tab list prints the names.
EOF
	exit 1
}

json_field() {
	node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{let j={};try{j=JSON.parse(d)}catch{}const v=process.argv[1].split(".").reduce((a,k)=>a?.[k],j);if(v!==undefined&&v!==null)process.stdout.write(String(v))})' "${1:-}"
}

# looks_like_url — is this answer a repository to clone, rather than a folder on disk? The three
# shapes git itself accepts as a location (`https://…`, `ssh://…`, `git@host:path`) plus anything
# ending in `.git`. The scheme is anchored and holds only letters, digits, `+`, `.` or `-`, so a
# path that merely has `://` further in is still a path. A URL that is also a folder is a folder:
# the caller tests the directory first, and this function never sees the question.
looks_like_url() {
	case $1 in
	*.git) return 0 ;;
	git@*:*) return 0 ;;
	[a-zA-Z]*://*)
		printf '%s' "$1" | grep -Eq '^[a-zA-Z][a-zA-Z0-9+.-]*://[^[:space:]]+$' || return 1
		return 0
		;;
	esac
	return 1
}

# cmd_new_ask — the questions a bare `space new` asks, in the shape a person answers:
# `name [<folder's basename>]:`, `where [<$PWD>]:`, `create it? [Y/n]:` and `is it a git project?
# [Y/n]:`. An empty line takes the default — for the first two the default is the thing shown; on
# `create it?` it is yes and on the git question it is yes. `n` on `create it?` touches nothing.
# The questions go to stderr, so stdout stays the one line that matters; a `read` that hits
# end-of-file with nothing in it means nothing can answer — a script, not a person — and that is
# the usage error, not a prompt nobody sees.
#
# A flag that already answers a question means the question is not asked: `--project`, `--here`
# and `.` answer `where` with a folder, `--clone` answers it with a URL (and answers the git
# question by definition), `--no-git` answers the git question. Both remaining questions are
# asked only where the answer changes something: a folder that has to be made, and a folder with
# no `.git` of its own.
ASK_NAME=""
ASK_PROJECT=""
ASK_CLONE=""
ASK_NOGIT=0
cmd_new_ask() {
	local base answer project=${1:-} clone=${2:-} no_git=${3:-0}
	base=$(basename -- "$PWD")
	if [ -t 0 ]; then printf 'name [%s]: ' "$base" >&2; fi
	IFS= read -r answer || usage
	ASK_NAME=${answer:-$base}
	# Question 2 is skipped when a flag already answered it: --project, --here and ` .` name a
	# folder, --clone names a URL.
	if [ -z "$project" ] && [ -z "$clone" ]; then
		if [ -t 0 ]; then printf 'where [%s]: ' "$PWD" >&2; fi
		IFS= read -r answer || answer=""
		answer=${answer:-$PWD}
		if [ -d "$answer" ]; then
			# A folder that is there wins over any URL reading, so a checkout is never cloned over.
			project=$answer
			printf 'space: folder %s\n' "$project" >&2
		elif looks_like_url "$answer"; then
			clone=$answer
			printf 'space: cloning %s into %s/projects/%s\n' "$clone" "$HOME" "$ASK_NAME" >&2
		else
			project=$answer
			printf 'space: folder %s\n' "$project" >&2
			if [ -t 0 ]; then printf 'create it? [Y/n]: ' >&2; fi
			IFS= read -r answer || answer=""
			case $answer in
			"" | y | Y | yes | YES | Yes)
				mkdir -p -- "$project" || return 1
				;;
			*)
				say "space: nothing created"
				return 1
				;;
			esac
		fi
	fi
	# Question 4: only for a folder with no `.git` of its own, and never when --no-git answered it.
	# `y` and `n` both leave the record saying `git: false` here — there is no repository and no
	# remote, so `y` only says the answer was read.
	if [ -n "$project" ] && [ "$no_git" = 0 ] && [ ! -e "$project/.git" ]; then
		if [ -t 0 ]; then printf 'is it a git project? [Y/n]: ' >&2; fi
		IFS= read -r answer || answer=""
		case $answer in
		"" | y | Y | yes | YES | Yes) ;;
		*) no_git=1 ;;
		esac
	fi
	ASK_PROJECT=$project ASK_CLONE=$clone ASK_NOGIT=$no_git
	return 0
}

cmd_new() {
	local name="" project="" clone="" no_git=0 tabname="Boss" kind="project" boss_argv=""
	local positional=0 here=0
	while [ "$#" -gt 0 ]; do
		case $1 in
		--name) name=${2:-}; positional=0; shift 2 ;;
		--project) project=${2:-}; shift 2 ;;
		--here) here=1; shift ;;
		--clone) clone=${2:-}; shift 2 ;;
		--kind) kind=${2:-}; shift 2 ;;
		--no-git) no_git=1; shift ;;
		--tab-name) tabname=${2:-Boss}; shift 2 ;;
		--argv) boss_argv=${2:-}; shift 2 ;;
		-h | --help) usage ;;
		-*) die "unknown option $1" ;;
		*)
			if [ -z "$name" ]; then
				name=$1
				positional=1
			elif [ -z "$project" ] && [ "$1" = . ]; then
				# `space new demo .` is the same sentence as `--project .`: the folder you are in.
				project=$PWD
			else
				die "space new takes one name, and '$1' is a second one — bin/space new <slug>"
			fi
			shift
			;;
		esac
	done
	# `--here` and `.` are the same answer as leaving the folder out: the folder you are standing in.
	[ "$here" = 0 ] || project=$PWD
	[ "$project" != . ] || project=$PWD
	# No name at all means a person is typing it, so the questions are asked, each one skipped when a
	# flag already answered it. `space new <name>` names the space in the command and asks nothing —
	# that is the scripted path — and a `--name` without a folder keeps the old refusal.
	if [ -z "$name" ]; then
		cmd_new_ask "$project" "$clone" "$no_git" || exit 1
		name=$ASK_NAME project=$ASK_PROJECT clone=$ASK_CLONE no_git=$ASK_NOGIT
		positional=0
	fi
	# A name given as the argument is the whole command: the project is where you are.
	if [ "$positional" = 1 ] && [ -z "$project" ] && [ -z "$clone" ]; then project=$PWD; fi
	case $kind in
	harness | project) ;;
	*) die "--kind takes harness or project, not '$kind'" ;;
	esac
	space_valid_slug "$name" || die "a space name is a slug: [a-z0-9][a-z0-9-]{0,30} — '$name' is not"
	# A name is the whole handle a person types later, so a second space under it would make
	# `delegate --space <slug>` ambiguous. Refused by name, naming the project already using it.
	if space_exists "$name"; then
		die "space '$name' already exists for $(space_field "$name" project) — pick another name, or bin/space show $name"
	fi
	[ -n "$project" ] || [ -n "$clone" ] || die "space new needs --project PATH (a folder already on disk) or --clone URL"
	[ -z "$project" ] || [ -z "$clone" ] || die "--project and --clone answer the same question; give one"
	# A clone is a git repository by definition, so `--no-git` beside it answers a question the clone
	# already answered. Refused, not silently dropped: the record would say `git: false` about a
	# folder `git clone` just made.
	[ -z "$clone" ] || [ "$no_git" = 0 ] ||
		die "--clone and --no-git answer the same question; a clone is a git project"

	need node
	# The Boss tab's argv is opened and recorded, and the record is what the guard reopens the tab
	# with after a reboot: a broken one is refused here, not written down and replayed later.
	if [ -z "$boss_argv" ]; then
		boss_argv=$(BARE=$pi_bare node -e 'process.stdout.write(JSON.stringify([process.env.BARE]))')
	else
		boss_argv=$(node -e '
			let a;
			try { a = JSON.parse(process.argv[1]); } catch { process.exit(2); }
			if (!Array.isArray(a) || !a.length || a.some((v) => typeof v !== "string" || !v)) process.exit(2);
			process.stdout.write(JSON.stringify(a));
		' "$boss_argv") || die "--argv takes a JSON array of strings, like --argv '[\"pi\"]' — got '$boss_argv'"
		# One line, not a silent acceptance: a sandboxed Boss is the thing this record exists to
		# prevent, so it is refused here rather than written down and replayed after a reboot.
		sandboxed=$(ARGV=$boss_argv node -e '
			let a = [];
			try { a = JSON.parse(process.env.ARGV || "[]"); } catch {}
			if (!Array.isArray(a) || !a.length) process.exit(0);
			const first = String(a[0] || "").split("/").pop();
			if ("pi pisandbox pi-sandboxed".split(" ").includes(first)) process.stdout.write(first);
		') || sandboxed=""
		[ -z "$sandboxed" ] ||
			die "the Boss is bare: --argv takes $pi_bare, not '$sandboxed' — workers are sandboxed, the Boss is not"
	fi
	# No `need hc`: `space new` opens the space through herdr-app and never talks to
	# herdr-core itself. Demanding hc refused every offline test and every runner.

	local remote=""
	if [ -n "$clone" ]; then
		project=$HOME/projects/$name
		if [ -d "$project" ] && [ -n "$(ls -A "$project" 2>/dev/null)" ]; then
			die "cannot clone $name into $project: that folder exists and is not empty — move it aside, or bin/space new --name $name --project $project"
		fi
		mkdir -p "$HOME/projects"
		if ! git clone -- "$clone" "$project" >&2; then
			die "git clone $clone $project failed — nothing was recorded, nothing was opened"
		fi
	else
		[ -d "$project" ] || die "no such project folder: $project — create it first, or use --clone URL"
		project=$(readlink -f -- "$project")
		space_writable "$project" ||
			die "project folder $project is not writable — a space there could not be worked in"
	fi

	local git=false
	if [ "$no_git" = 0 ] && [ -e "$project/.git" ]; then git=true; fi
	if [ "$git" = true ]; then
		remote=$(git -C "$project" remote get-url origin 2>/dev/null || true)
	fi

	# A missing app is a refusal that names the one command to run by hand, before a folder is made:
	# nothing is recorded and no folder is touched, so the person can run it later and lose nothing.
	command -v herdr-app >/dev/null 2>&1 ||
		die "herdr-app is not on PATH — nothing was recorded, nothing was opened; once herdr is back, run it by hand: herdr-app do space.new --name $name --folder $project --tab $tabname --argv $boss_argv"

	mkdir -p "$(space_specs "$name")" "$(space_reports "$name")"
	local out space tab terminal
	out=$(herdr-app do space.new --name "$name" --folder "$project" --tab "$tabname" --argv "$boss_argv" 2>&1) ||
		die "space.new failed for $name: $out"
	space=$(json_field space <<<"$out")
	[ -n "$space" ] || space=$(json_field id <<<"$out")
	tab=$(json_field tab <<<"$out")
	terminal=$(json_field terminal <<<"$out")
	[ -n "$space" ] || die "could not read the new space id from: $out"

	NAME=$name PROJECT=$project GIT=$git REMOTE=$remote TAB=$tab TERMINAL=$terminal ID=$space KIND=$kind \
		BOSS=$tabname BOSS_ARGV=$boss_argv node -e '
		const fs = require("fs");
		const rec = {
			name: process.env.NAME,
			id: process.env.ID || "",
			// The kind is written on every new record: a learner reads it to know whether it may
			// touch the harness or only the rules file of the project.
			kind: process.env.KIND === "harness" ? "harness" : "project",
			project: process.env.PROJECT,
			git: process.env.GIT === "true",
			remote: process.env.REMOTE || "",
			created: new Date().toISOString(),
			// The Boss tab by name and by the argv it was opened with. `uberboss_tab` below is the
			// herdr id of that tab and nothing else: a reader that wants the name reads `boss`.
			boss: process.env.BOSS || "Boss",
			boss_argv: (() => {
				try { const a = JSON.parse(process.env.BOSS_ARGV || "[]"); return Array.isArray(a) ? a : []; } catch { return []; }
			})(),
			uberboss_tab: process.env.TAB || "",
			terminals: process.env.TERMINAL ? [process.env.TERMINAL] : [],
		};
		fs.writeFileSync(process.argv[1], JSON.stringify(rec, null, 2) + "\n");
	' "$(space_record "$name")"

	if ! space_rules_write "$name" "$project"; then
		printf '%s: warning: %s was created, but %s holds no rules block (%s is missing)\n' \
			"$prog" "$name" "$project/AGENTS.md" "$SPACE_RULES_TEMPLATE" >&2
	fi

	say "space: $name on $project (${tabname} tab opened)"
	say "next: cd $project && bin/delegate spawn <worker> --cwd $project \"<task>\""
}

# cmd_list — one line per record, and whether the app has it open right now:
#
#   harness  harness  /home/mark/.pi  git  1 tabs  live sp7104110    Boss tab
#   bakmark  project  /home/mark/projects/bakmark  git  2 tabs  not in herdr-app  Boss tab
#
# `herdr-app ls` is read once. When the app is missing or its answer is not JSON, every record is
# still listed (its liveness column reads `unknown`) and one line at the end says so — a list that
# hides every space because herdr is down is worse than a list that is honest about one column.
# `--json` is the same answer for a script: each record as written, plus `live` and `live_id`.
cmd_list() {
	local json=0
	while [ "$#" -gt 0 ]; do
		case $1 in
		--json) json=1; shift ;;
		*) die "list takes no options but --json, not '$1'" ;;
		esac
	done
	command -v node >/dev/null 2>&1 || die "node is not on PATH"
	local slugs s project git tabs state kind boss live="" live_id="" snap="" unavailable=0
	slugs=$(space_slugs)
	if [ -z "$slugs" ]; then
		if [ "$json" = 1 ]; then say "[]"; else say "no spaces — bin/space new <slug> in the project folder"; fi
		return 0
	fi
	if command -v herdr-app >/dev/null 2>&1; then
		snap=$(herdr-app ls 2>/dev/null) || snap=""
	fi
	if [ -z "$snap" ]; then
		unavailable=1
	elif ! live=$(printf '%s' "$snap" | node -e '
			let d = "";
			process.stdin.on("data", (c) => (d += c)).on("end", () => {
				let j = {};
				try { j = JSON.parse(d); } catch { process.exit(3); }
				if (!j || typeof j !== "object" || !Array.isArray(j.spaces)) process.exit(3);
				for (const s of j.spaces) if (s && s.name && s.id) process.stdout.write(String(s.name) + "\t" + String(s.id) + "\n");
			});
		'); then
		unavailable=1
		live=""
	fi
	if [ "$json" = 1 ]; then
		LIVE=$live SLUGS=$slugs SPACES_DIR=$SPACES_DIR node -e '
			const fs = require("fs"), path = require("path");
			const byName = new Map();
			for (const line of String(process.env.LIVE || "").split("\n")) {
				const [name, id] = line.split("\t");
				if (name && id) byName.set(name, id);
			}
			const ids = new Set([...byName.values()]);
			const out = [];
			for (const slug of String(process.env.SLUGS || "").split("\n")) {
				if (!slug) continue;
				let rec = {};
				try { rec = JSON.parse(fs.readFileSync(path.join(process.env.SPACES_DIR, slug, "space.json"), "utf8")); } catch {}
				// The name is the handle; the herdr id is the second chance, for a record renamed in the app.
				const liveId = byName.get(slug) || (rec.id && ids.has(String(rec.id)) ? String(rec.id) : "");
				out.push(Object.assign({}, rec, { live: Boolean(liveId), live_id: liveId }));
			}
			process.stdout.write(JSON.stringify(out, null, 2) + "\n");
		'
		return 0
	fi
	while IFS= read -r s; do
		[ -n "$s" ] || continue
		project=$(space_field "$s" project)
		kind=$(space_kind "$s")
		git=$(space_field "$s" git)
		[ "$git" = true ] && git=git || git=no-git
		tabs=$(node -e '
			const fs=require("fs");let j={};try{j=JSON.parse(fs.readFileSync(process.argv[1],"utf8"))}catch{}
			process.stdout.write(String(Array.isArray(j.terminals)?j.terminals.length:0));' "$(space_record "$s")")
		boss=$(space_field "$s" boss)
		[ -n "$boss" ] || boss=Boss
		if [ "$unavailable" = 1 ]; then
			state=unknown
		else
			# The name first; herdr's id is the second chance, for a record the app renamed.
			live_id=$(printf '%s\n' "$live" | awk -F'\t' -v n="$s" '$1 == n { print $2; exit }')
			if [ -z "$live_id" ]; then
				live_id=$(space_field "$s" id)
				if [ -n "$live_id" ] && ! printf '%s\n' "$live" | awk -F'\t' -v i="$live_id" '$2 == i { found = 1 } END { exit !found }'; then
					live_id=""
				fi
			fi
			if [ -n "$live_id" ]; then state="live $live_id"; else state="not in herdr-app"; fi
		fi
		printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$s" "$kind" "$project" "$git" "$tabs tabs" "$state" "$boss tab"
	done <<<"$slugs" | awk -F'\t' '{ printf "%-20s %-8s %-40s %-7s %-8s %-18s %s\n", $1, $2, $3, $4, $5, $6, $7 }'
	[ "$unavailable" = 0 ] || printf 'herdr-app: unavailable — the liveness column says unknown, the records are all still here\n' >&2
}

cmd_show() {
	local slug=${1:-}
	[ -n "$slug" ] || usage
	space_exists "$slug" || die "no such space: $slug — bin/space list"
	node -e '
		const fs=require("fs");
		const j=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));
		const order=["name","id","project","git","remote","created","boss","boss_argv","uberboss_tab","terminals"];
		for (const k of order) if (k in j) {
			const v=j[k];
			console.log(k+": "+(Array.isArray(v)?(v.length?v.join(", "):"(none)"):(v===true?"true":v===false?"false":(v||"-"))));
		}
	' "$(space_record "$slug")"
	# Read through `space_kind` rather than printed from the record: a record written before the
	# field existed is a project space, and this is the same answer the learner gets.
	printf 'kind: %s\n' "$(space_kind "$slug")"
	if [ -n "$(space_field "$slug" max_open_prs)" ]; then
		printf 'max_open_prs: %s\n' "$(space_max_open_prs "$slug")"
	else
		printf 'max_open_prs: %s (default)\n' "$(space_max_open_prs "$slug")"
	fi
	printf 'specs: %s\n' "$(space_specs "$slug")"
	printf 'reports: %s\n' "$(space_reports "$slug")"
}

# cmd_policy — `max_open_prs`, read and written in one place.
#
# The rule a space keeps is `merged before the next`, and the record is where a space says it keeps
# a different one: a repo other people work in, a prototyping repo. No flag prints the effective
# value and says `1 (default)` when the field is absent, so a person reads what the gate will do
# rather than what the file says. With `--max-open-prs` only that field is written, through the
# record's temp-file-plus-rename path: every other field, and every other space's record, is
# untouched. A value that is neither an integer of 1 or more nor `unbounded` is refused naming both
# accepted forms — the gate is not a place for a guess at what `0` meant.
cmd_policy() {
	local slug="" value="" setter=0 json=0 recorded effective
	while [ "$#" -gt 0 ]; do
		case $1 in
		--max-open-prs) value=${2:-}; setter=1; shift 2 ;;
		--json) json=1; shift ;;
		-h | --help) usage ;;
		-*) die "unknown option $1" ;;
		*)
			[ -z "$slug" ] || die "policy takes one space name, and '$1' is a second one"
			slug=$1
			shift
			;;
		esac
	done
	[ -n "$slug" ] || usage
	space_exists "$slug" || die "no such space: $slug — bin/space list"
	if [ "$setter" = 1 ]; then
		if [ "$value" != unbounded ] && ! printf '%s' "$value" | grep -Eq '^[1-9][0-9]*$'; then
			die "--max-open-prs takes an integer of 1 or more, or unbounded; '$value' is neither.
  bin/space policy $slug --max-open-prs 3
  bin/space policy $slug --max-open-prs unbounded"
		fi
		space_set_field "$slug" max_open_prs "$value" ||
			die "could not rewrite $(space_record "$slug") — nothing changed"
	fi
	recorded=$(space_field "$slug" max_open_prs)
	effective=$(space_max_open_prs "$slug")
	if [ "$json" = 1 ]; then
		SPACE=$slug VALUE=$effective DEFAULTED=$([ -n "$recorded" ] && printf false || printf true) node -e '
			const v = process.env.VALUE;
			process.stdout.write(JSON.stringify({
				space: process.env.SPACE,
				max_open_prs: v === "unbounded" ? "unbounded" : Number(v),
				default: process.env.DEFAULTED === "true",
			}) + "\n");
		'
		return 0
	fi
	if [ -n "$recorded" ]; then
		say "max_open_prs: $effective"
	else
		say "max_open_prs: $effective (default)"
	fi
}

# cmd_move — point a record at another folder, and change nothing else it can keep.
#
# A record outlives the folder it was made in: a checkout renamed, a clone replaced, a workspace
# retired. The move keeps `id`, `boss`, `boss_argv`, the tabs and every report — they live beside
# the record, not in the project — so the guard still recognises the live space and opens no
# second one. The tabs that sat in the old folder follow it, because a tab with a dead cwd is a
# tab the app cannot start; the two ways to make the record a lie are refused by name: a folder
# that is not there, and a folder another record already claims (one folder is one space).
#
# `git` and `remote` are answers about the folder, not history, so the move re-derives them the way
# `space new` does. `bin/delegate` counts a space's open pull requests with that `remote`: a
# repository renamed leaves the record naming the old one, and GitHub's rename redirect hides it
# until somebody registers the old name — then the gate counts pull requests in a repository this
# space is not. One writer, here: nothing else derives `remote` at read time. Moving a space to the
# folder it is already on is the refresh, not a refusal.
cmd_move() {
	local slug="" project="" json=0
	while [ "$#" -gt 0 ]; do
		case $1 in
		--project) project=${2:-}; shift 2 ;;
		--json) json=1; shift ;;
		-*) die "unknown option $1" ;;
		*)
			[ -z "$slug" ] || die "move takes one space name, and '$1' is a second one"
			slug=$1
			shift
			;;
		esac
	done
	[ -n "$slug" ] || usage
	space_exists "$slug" || die "no such space: $slug — bin/space list"
	[ -n "$project" ] || die "space move needs --project PATH — bin/space move $slug --project /the/new/folder"
	[ -d "$project" ] || die "no such folder: $project — a space points at a folder that is there"
	project=$(readlink -f -- "$project")
	local other other_project
	while IFS= read -r other; do
		[ -n "$other" ] || continue
		[ "$other" = "$slug" ] && continue
		other_project=$(space_field "$other" project)
		[ -n "$other_project" ] || continue
		other_project=$(cd -- "$other_project" 2>/dev/null && pwd -P) || other_project=""
		[ -n "$other_project" ] || continue
		[ "$other_project" = "$project" ] || continue
		die "$project is already the project of space '$other' — one folder is one space, so give the move another folder (bin/space show $other)"
	done <<<"$(space_slugs)"
	command -v node >/dev/null 2>&1 || die "node is not on PATH"
	local before before_git before_remote move_git=false move_remote="" origin_read=1
	before=$(space_field "$slug" project)
	before_git=$(space_field "$slug" git)
	before_remote=$(space_field "$slug" remote)
	# A folder that has become a repository is `git: true`, one that no longer is says false; a
	# `--no-git` record on a folder with no `.git` lands on the same false. `git` failing is an
	# empty answer and never a refusal — a folder with a broken `.git` still moves, and the record
	# then says `git: true` with no remote, which is said out loud below.
	if [ -e "$project/.git" ]; then
		move_git=true
		if ! move_remote=$(git -C "$project" remote get-url origin 2>/dev/null); then
			move_remote=""
			origin_read=0
		fi
	fi
	MOVE_SLUG=$slug MOVE_PROJECT=$project MOVE_GIT=$move_git MOVE_REMOTE=$move_remote SPACES_DIR=$SPACES_DIR node -e '
		const fs = require("fs"), path = require("path");
		const file = path.join(process.env.SPACES_DIR, process.env.MOVE_SLUG, "space.json");
		let r;
		try { r = JSON.parse(fs.readFileSync(file, "utf8")); } catch { process.exit(3); }
		const before = String(r.project || "");
		r.project = String(process.env.MOVE_PROJECT);
		// The tabs in the old folder follow it; a tab deliberately placed elsewhere is left where
		// the person put it.
		for (const t of Array.isArray(r.tabs) ? r.tabs : []) {
			if (t && typeof t === "object" && String(t.folder || "") === before) t.folder = r.project;
		}
		// The two fields the folder answers, in the same write that moves `project`. No remote is
		// no field: `space new` writes one only when there is a URL, and a stale one here is the
		// lie this refresh exists to remove.
		r.git = process.env.MOVE_GIT === "true";
		const remote = String(process.env.MOVE_REMOTE || "");
		if (remote) r.remote = remote;
		else delete r.remote;
		fs.writeFileSync(file, JSON.stringify(r, null, 2) + "\n");
	' "$(space_record "$slug")" || die "could not rewrite $(space_record "$slug") — nothing changed"
	if [ "$json" = 1 ]; then
		cat "$(space_record "$slug")"
		return 0
	fi
	if [ -n "$before" ] && [ "$before" = "$project" ]; then
		say "space: $slug is already $project"
	else
		say "space: $slug -> $project"
	fi
	# Said only when it changed: the common move stays quiet about what it found the same.
	[ "${before_git:-false}" = "$move_git" ] || say "git: ${before_git:-false} -> $move_git"
	if [ "$origin_read" = 0 ]; then
		# A repository git cannot read. Said only when that is news: a move that finds exactly
		# what the record already said stays quiet, like every other unchanged field.
		if [ -n "$before_remote" ] || [ "${before_git:-false}" != "$move_git" ]; then
			say "remote: - (could not read an origin in $project — the record says git: $move_git with no remote)"
		fi
	elif [ "${before_remote:--}" != "${move_remote:--}" ]; then
		say "remote: ${before_remote:--} -> ${move_remote:--}"
	fi
	# herdr cannot move a tab, so the Boss's next command opens the same tab in the new folder, in
	# the same space (the record's id) and with the argv the record keeps. No id recorded means no
	# live space to aim at, and then the one command is the guard adopting the record.
	local next
	next=$(NEXT_RECORD=$(space_record "$slug") node -e '
		const fs = require("fs");
		let r = {};
		try { r = JSON.parse(fs.readFileSync(process.env.NEXT_RECORD, "utf8")); } catch {}
		const id = String(r.id || "");
		if (!id) { process.stdout.write("bin/guard --once"); process.exit(0); }
		const boss = String(r.boss || "Boss");
		let out = "herdr-app do tab.new --name " + boss + " --space " + id + " --folder " + r.project;
		if (Array.isArray(r.boss_argv) && r.boss_argv.length) {
			// One shell word, apostrophes escaped the way sh reads them back.
			const q = String.fromCharCode(39);
			const argv = JSON.stringify(r.boss_argv).split(q).join(q + "\\" + q + q);
			out += " --argv " + q + argv + q;
		}
		process.stdout.write(out + " --focus false");
	')
	say "next: $next"
}

# cmd_forget — drop the record, and nothing else. The record is what the guard reopens from, so
# dropping it is a decision, and a `y` answered to a question nobody read is not a decision: the
# question says exactly what goes and what stays, and only the space's name typed back does it.
# A script has nobody to answer, so it passes `--yes` — the question is not skipped, it is
# answered up front, and the same explanation goes to stderr so the destructive path is never
# silent. Anything but the exact name (trimmed) keeps the space and says so.
cmd_forget() {
	local slug="" yes=0 answer project explanation
	while [ "$#" -gt 0 ]; do
		case $1 in
		--yes | -y) yes=1; shift ;;
		-*) die "unknown option $1" ;;
		*)
			[ -z "$slug" ] || die "forget takes one space name, and '$1' is a second one"
			slug=$1
			shift
			;;
		esac
	done
	[ -n "$slug" ] || usage
	space_exists "$slug" || die "no such space: $slug — bin/space list"
	if [ "$yes" = 0 ] && [ ! -t 0 ]; then
		die "forget $slug needs an answer, and nothing here can give one — bin/space forget $slug --yes"
	fi
	project=$(space_field "$slug" project)
	[ -n "$project" ] || project="(no project folder recorded)"
	explanation="$slug is a durable space: $project
  dropped: its record ($(space_record "$slug")), its tabs, and the guard reopening it at login
  kept:    reports/, specs/, delegations.json and cache/ in $(space_dir "$slug") on this disk"
	printf '%s\n' "$explanation" >&2
	if [ "$yes" = 0 ]; then
		printf 'Type the space name to drop its record, or press Enter to keep it: ' >&2
		IFS= read -r answer || answer=""
		# Trimmed both ends: a name pasted with a trailing space is the same name.
		answer=${answer#"${answer%%[![:space:]]*}"}
		answer=${answer%"${answer##*[![:space:]]}"}
		if [ "$answer" != "$slug" ]; then
			say "$slug: kept — nothing was dropped"
			return 1
		fi
	fi
	# The record is dropped; the space itself is not closed, and the folder it was is said out
	# loud rather than deleted. Forgetting is about the list, not about the person's work.
	rm -f "$(space_record "$slug")"
	say "forgot $slug: dropped $(space_record "$slug") (its herdr space is still open, and $(space_dir "$slug") is still on disk)"
}

# cmd_tab — one tab of a space's record: the list, and the verb that removes an entry.
#
# A durable space records `tabs[]`, and `bin/guard` rebuilds every entry in it when the space is
# gone (a reboot, a herdr restart), so a tab a person closed comes back on the next rebuild.
# `forget` removes that one entry and nothing else. It edits a file: it never talks to herdr, never
# closes a tab, and a space with no herdr id or no app running is not a failure here.
#
# Three refusals, each by name:
#   - the Boss tab: the record exists to bring the Boss back, so it is never removed; a space nobody
#     wants is `bin/space forget <slug>`.
#   - a name no entry matches, naming the entries that do exist — a typo must not read as "done".
#   - a tab a tracked worker still uses (`delegations.json`, by worker slug or by tab id): closing
#     the record of a working tab leaves a worker nobody can find.
cmd_tab_forget() {
	local slug="" name="" json=0 tabs left live boss rc=0
	while [ "$#" -gt 0 ]; do
		case $1 in
		--json) json=1; shift ;;
		-*) die "unknown option $1" ;;
		*)
			if [ -z "$slug" ]; then
				slug=$1
			elif [ -z "$name" ]; then
				name=$1
			else
				die "tab forget takes a space name and a tab name, and '$1' is a third word"
			fi
			shift
			;;
		esac
	done
	if [ -z "$slug" ] || [ -z "$name" ]; then usage; fi
	space_exists "$slug" || die "no such space: $slug — bin/space list"
	command -v node >/dev/null 2>&1 || die "node is not on PATH"
	boss=$(space_field "$slug" boss)
	[ -n "$boss" ] || boss=Boss
	if [ "$name" = "$boss" ]; then
		die "$name is the Boss tab of $slug, and the Boss is never closed — the guard restores it from this record, so removing it would open an empty space
A space nobody wants is dropped whole: bin/space forget $slug"
	fi
	tabs=$(space_tabs "$slug")
	if ! printf '%s\n' "$tabs" | grep -Fxq -- "$name"; then
		die "$slug records no tab called '$name' — its tabs: $(printf '%s\n' "$tabs" | grep . | paste -sd, - | sed 's/,/, /g')"
	fi
	# A worker the delegate still tracks is a tab somebody is using: its entry stays until the
	# worker is closed, and that command is the one the refusal names.
	live=$(SPACE_FILE=$(space_record "$slug") DELEGATIONS=$(space_delegations "$slug") TAB_NAME=$name node -e '
		const fs = require("fs");
		let r = {};
		try { r = JSON.parse(fs.readFileSync(process.env.SPACE_FILE, "utf8")); } catch { process.exit(0); }
		const ids = new Set();
		for (const t of Array.isArray(r.tabs) ? r.tabs : [])
			if (t && typeof t === "object" && String(t.name || "") === process.env.TAB_NAME && t.id) ids.add(String(t.id));
		let d = {};
		try { d = JSON.parse(fs.readFileSync(process.env.DELEGATIONS, "utf8")); } catch { process.exit(0); }
		for (const slug of Object.keys(d)) {
			const e = d[slug] || {};
			if (slug === process.env.TAB_NAME || (e.tab && ids.has(String(e.tab)))) {
				process.stdout.write(String(slug));
				process.exit(0);
			}
		}
	')
	if [ -n "$live" ]; then
		die "$name is the tab of the worker '$live', which the delegate still tracks — closing its record would leave a worker nobody can find
Close the worker first: bin/delegate close $live"
	fi
	left=$(space_remove_tab "$slug" "$name") || {
		rc=$?
		[ "$rc" != 3 ] || die "$slug records no tab called '$name' — nothing changed"
		die "could not rewrite $(space_record "$slug") — nothing changed"
	}
	if [ "$json" = 1 ]; then
		TAB_NAME=$name TABS=$left node -e '
			const tabs = String(process.env.TABS || "").split("\n").filter(Boolean);
			process.stdout.write(JSON.stringify({ name: process.env.TAB_NAME, removed: true, tabs }) + "\n");
		'
		return 0
	fi
	say "space: $slug: tab $name forgotten"
	say "  the guard will no longer re-create it; still recorded: $(if [ -n "$left" ]; then printf '%s\n' "$left" | paste -sd, - | sed 's/,/, /g'; else printf 'no tabs'; fi)"
}

cmd_tab_list() {
	local slug="" json=0 tabs
	while [ "$#" -gt 0 ]; do
		case $1 in
		--json) json=1; shift ;;
		-*) die "unknown option $1" ;;
		*)
			[ -z "$slug" ] || die "tab list takes one space name, and '$1' is a second one"
			slug=$1
			shift
			;;
		esac
	done
	[ -n "$slug" ] || usage
	space_exists "$slug" || die "no such space: $slug — bin/space list"
	tabs=$(space_tabs "$slug")
	if [ "$json" = 1 ]; then
		TABS=$tabs node -e 'process.stdout.write(JSON.stringify({ space: process.argv[1], tabs: String(process.env.TABS || "").split("\n").filter(Boolean) }) + "\n")' "$slug"
		return 0
	fi
	if [ -z "$tabs" ]; then
		say "$slug: no tabs recorded"
		return 0
	fi
	printf '%s\n' "$tabs"
}

cmd_tab() {
	local verb=${1:-}
	[ "$#" -eq 0 ] || shift
	case $verb in
	forget) cmd_tab_forget "$@" ;;
	list | ls) cmd_tab_list "$@" ;;
	*) die "tab takes forget or list — bin/space tab forget <slug> <name>" ;;
	esac
}

case ${1:-} in
new) shift; cmd_new "$@" ;;
list | ls) shift; cmd_list "$@" ;;
show) shift; cmd_show "$@" ;;
policy) shift; cmd_policy "$@" ;;
move) shift; cmd_move "$@" ;;
forget) shift; cmd_forget "$@" ;;
tab) shift; cmd_tab "$@" ;;
-h | --help | help) usage ;;
*) usage ;;
esac
