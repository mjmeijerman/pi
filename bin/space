#!/usr/bin/env bash
# space — the durable project spaces, and the only command the UI calls.
#
#   bin/space new [<slug>] [--project PATH | --here | --clone URL] [--kind harness|project]
#                  [--no-git] [--tab-name Boss] [--argv JSON]
#   bin/space new              (on a terminal: ask for the name and the folder, with defaults)
#   bin/space list [--json]
#   bin/space show <slug>
#   bin/space forget <slug> [--yes]
#
# A space is one project. It is durable: the record at state/spaces/<slug>/space.json outlives
# the terminals in it, so later workers can reopen the tabs and read where the work goes. The
# record carries herdr's id for the space (`id`), because a worker is opened as a tab inside it
# and `tab.new` takes that id; a record from before the field is filled in by `delegate` from
# `herdr-app ls`, by name, once.
#
# `kind` says what learning in the space may change, and the space decides it, never the session
# that compacted: a `harness` space is this pi checkout and its learner may edit the harness and
# publish its own branch; a `project` space (the default, and what a record without the field
# reads as) teaches that project's `AGENTS.md` and nothing else. One harness space per machine:
# a second one would be a second copy of the harness to disagree with the first.
# `bin/delegate` reads the space from the directory it is run in, and refuses in a folder no
# space claims — creating one here is the fix that refusal names.
#
# The project's AGENTS.md gets one block between two markers (agent/space-rules.md): one project
# per space, another project's work is answered with the command to run in its space, one worker
# at a time, merged before the next. Replacing means a re-run never grows a second copy.
set -euo pipefail

here=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)
# shellcheck source=bin/shell-resolve.sh
if [ -f "$here/shell-resolve.sh" ]; then . "$here/shell-resolve.sh"; fi
# shellcheck source=bin/space-lib.sh
. "$here/space-lib.sh"

# The Boss is bare: `bin/pi-bare` in this tree, never a sandboxed wrapper. Workers are sandboxed,
# the Boss is not, and a record that says otherwise brings a sandboxed Boss back after every reboot.
pi_home=$(cd -- "$here/.." && pwd)
pi_bare=$pi_home/bin/pi-bare

prog=space
die() { printf '%s: error: %s\n' "$prog" "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is not on PATH"; }

usage() {
	cat >&2 <<'EOF'
usage: bin/space new [<slug>] [--project PATH | --here | --clone URL] [--kind harness|project] [--no-git] [--tab-name Boss] [--argv JSON]
       bin/space new            (on a terminal: asks name, folder and "create it?", with defaults;
                                with nothing to read it prints this and exits 1, the script path)
       The name is the one positional: `bin/space new demo` in a project folder means --project $PWD.
       --argv is the Boss tab's command as a JSON array (default ["<pi home>/bin/pi-bare"]); it is
       opened with it and the record keeps it, so the guard reopens the same command. The Boss is
       bare: an --argv naming pi, pisandbox or pi-sandboxed is refused.
       bin/space list [--json]
       bin/space show <slug>
       bin/space forget <slug> [--yes]
EOF
	exit 1
}

json_field() {
	node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{let j={};try{j=JSON.parse(d)}catch{}const v=process.argv[1].split(".").reduce((a,k)=>a?.[k],j);if(v!==undefined&&v!==null)process.stdout.write(String(v))})' "${1:-}"
}

# cmd_new_ask — the three questions a bare `space new` asks, in the shape a person answers:
# `name [<folder's basename>]:`, `folder [<$PWD>]:`, `create it? [Y/n]:`. An empty line takes the
# default and `n` touches nothing. The questions go to stderr, so stdout stays the one line that
# matters; a `read` that hits end-of-file with nothing in it means nothing can answer — a script,
# not a person — and that is the usage error, not a prompt nobody sees.
ASK_NAME=""
ASK_FOLDER=""
cmd_new_ask() {
	local base answer
	base=$(basename -- "$PWD")
	if [ -t 0 ]; then printf 'name [%s]: ' "$base" >&2; fi
	IFS= read -r answer || usage
	ASK_NAME=${answer:-$base}
	if [ -t 0 ]; then printf 'folder [%s]: ' "$PWD" >&2; fi
	IFS= read -r answer || answer=""
	ASK_FOLDER=${answer:-$PWD}
	if [ -t 0 ]; then printf 'create it? [Y/n]: ' >&2; fi
	IFS= read -r answer || answer=""
	case $answer in
	"" | y | Y | yes | YES | Yes) return 0 ;;
	*)
		say "space: nothing created"
		return 1
		;;
	esac
}

cmd_new() {
	local name="" project="" clone="" no_git=0 tabname="Boss" kind="project" boss_argv=""
	local positional=0 here=0
	if [ "$#" -eq 0 ]; then
		cmd_new_ask || exit 1
		name=$ASK_NAME
		project=$ASK_FOLDER
		positional=1
	fi
	while [ "$#" -gt 0 ]; do
		case $1 in
		--name) name=${2:-}; positional=0; shift 2 ;;
		--project) project=${2:-}; shift 2 ;;
		--here) here=1; shift ;;
		--clone) clone=${2:-}; shift 2 ;;
		--kind) kind=${2:-}; shift 2 ;;
		--no-git) no_git=1; shift ;;
		--tab-name) tabname=${2:-Boss}; shift 2 ;;
		--argv) boss_argv=${2:-}; shift 2 ;;
		-h | --help) usage ;;
		-*) die "unknown option $1" ;;
		*)
			if [ -z "$name" ]; then
				name=$1
				positional=1
			elif [ -z "$project" ] && [ "$1" = . ]; then
				# `space new demo .` is the same sentence as `--project .`: the folder you are in.
				project=$PWD
			else
				die "space new takes one name, and '$1' is a second one — bin/space new <slug>"
			fi
			shift
			;;
		esac
	done
	# `--here` and `.` are the same answer as leaving the folder out: the folder you are standing in.
	[ "$here" = 0 ] || project=$PWD
	[ "$project" != . ] || project=$PWD
	# A name given as the argument is the whole command: the project is where you are. `--name` keeps
	# the old refusal, so a script that names a space without a folder still hears what is missing.
	if [ "$positional" = 1 ] && [ -z "$project" ] && [ -z "$clone" ]; then project=$PWD; fi
	case $kind in
	harness | project) ;;
	*) die "--kind takes harness or project, not '$kind'" ;;
	esac
	space_valid_slug "$name" || die "a space name is a slug: [a-z0-9][a-z0-9-]{0,30} — '$name' is not"
	# A name is the whole handle a person types later, so a second space under it would make
	# `delegate --space <slug>` ambiguous. Refused by name, naming the project already using it.
	if space_exists "$name"; then
		die "space '$name' already exists for $(space_field "$name" project) — pick another name, or bin/space show $name"
	fi
	[ -n "$project" ] || [ -n "$clone" ] || die "space new needs --project PATH (a folder already on disk) or --clone URL"
	[ -z "$project" ] || [ -z "$clone" ] || die "--project and --clone answer the same question; give one"

	need node
	# The Boss tab's argv is opened and recorded, and the record is what the guard reopens the tab
	# with after a reboot: a broken one is refused here, not written down and replayed later.
	if [ -z "$boss_argv" ]; then
		boss_argv=$(BARE=$pi_bare node -e 'process.stdout.write(JSON.stringify([process.env.BARE]))')
	else
		boss_argv=$(node -e '
			let a;
			try { a = JSON.parse(process.argv[1]); } catch { process.exit(2); }
			if (!Array.isArray(a) || !a.length || a.some((v) => typeof v !== "string" || !v)) process.exit(2);
			process.stdout.write(JSON.stringify(a));
		' "$boss_argv") || die "--argv takes a JSON array of strings, like --argv '[\"pi\"]' — got '$boss_argv'"
		# One line, not a silent acceptance: a sandboxed Boss is the thing this record exists to
		# prevent, so it is refused here rather than written down and replayed after a reboot.
		sandboxed=$(ARGV=$boss_argv node -e '
			let a = [];
			try { a = JSON.parse(process.env.ARGV || "[]"); } catch {}
			if (!Array.isArray(a) || !a.length) process.exit(0);
			const first = String(a[0] || "").split("/").pop();
			if ("pi pisandbox pi-sandboxed".split(" ").includes(first)) process.stdout.write(first);
		') || sandboxed=""
		[ -z "$sandboxed" ] ||
			die "the Boss is bare: --argv takes $pi_bare, not '$sandboxed' — workers are sandboxed, the Boss is not"
	fi
	# No `need hc`: `space new` opens the space through herdr-app and never talks to
	# herdr-core itself. Demanding hc refused every offline test and every runner.

	local remote=""
	if [ -n "$clone" ]; then
		project=$HOME/projects/$name
		if [ -d "$project" ] && [ -n "$(ls -A "$project" 2>/dev/null)" ]; then
			die "cannot clone $name into $project: that folder exists and is not empty — move it aside, or bin/space new --name $name --project $project"
		fi
		mkdir -p "$HOME/projects"
		if ! git clone -- "$clone" "$project" >&2; then
			die "git clone $clone $project failed — nothing was recorded, nothing was opened"
		fi
	else
		[ -d "$project" ] || die "no such project folder: $project — create it first, or use --clone URL"
		project=$(readlink -f -- "$project")
		space_writable "$project" ||
			die "project folder $project is not writable — a space there could not be worked in"
	fi

	local git=false
	if [ "$no_git" = 0 ] && [ -e "$project/.git" ]; then git=true; fi
	if [ "$git" = true ]; then
		remote=$(git -C "$project" remote get-url origin 2>/dev/null || true)
	fi

	# A missing app is a refusal that names the one command to run by hand, before a folder is made:
	# nothing is recorded and no folder is touched, so the person can run it later and lose nothing.
	command -v herdr-app >/dev/null 2>&1 ||
		die "herdr-app is not on PATH — nothing was recorded, nothing was opened; once herdr is back, run it by hand: herdr-app do space.new --name $name --folder $project --tab $tabname --argv $boss_argv"

	mkdir -p "$(space_specs "$name")" "$(space_reports "$name")"
	local out space tab terminal
	out=$(herdr-app do space.new --name "$name" --folder "$project" --tab "$tabname" --argv "$boss_argv" 2>&1) ||
		die "space.new failed for $name: $out"
	space=$(json_field space <<<"$out")
	[ -n "$space" ] || space=$(json_field id <<<"$out")
	tab=$(json_field tab <<<"$out")
	terminal=$(json_field terminal <<<"$out")
	[ -n "$space" ] || die "could not read the new space id from: $out"

	NAME=$name PROJECT=$project GIT=$git REMOTE=$remote TAB=$tab TERMINAL=$terminal ID=$space KIND=$kind \
		BOSS=$tabname BOSS_ARGV=$boss_argv node -e '
		const fs = require("fs");
		const rec = {
			name: process.env.NAME,
			id: process.env.ID || "",
			// The kind is written on every new record: a learner reads it to know whether it may
			// touch the harness or only the rules file of the project.
			kind: process.env.KIND === "harness" ? "harness" : "project",
			project: process.env.PROJECT,
			git: process.env.GIT === "true",
			remote: process.env.REMOTE || "",
			created: new Date().toISOString(),
			// The Boss tab by name and by the argv it was opened with. `uberboss_tab` below is the
			// herdr id of that tab and nothing else: a reader that wants the name reads `boss`.
			boss: process.env.BOSS || "Boss",
			boss_argv: (() => {
				try { const a = JSON.parse(process.env.BOSS_ARGV || "[]"); return Array.isArray(a) ? a : []; } catch { return []; }
			})(),
			uberboss_tab: process.env.TAB || "",
			terminals: process.env.TERMINAL ? [process.env.TERMINAL] : [],
		};
		fs.writeFileSync(process.argv[1], JSON.stringify(rec, null, 2) + "\n");
	' "$(space_record "$name")"

	if ! space_rules_write "$name" "$project"; then
		printf '%s: warning: %s was created, but %s holds no rules block (%s is missing)\n' \
			"$prog" "$name" "$project/AGENTS.md" "$SPACE_RULES_TEMPLATE" >&2
	fi

	say "space: $name on $project (${tabname} tab opened)"
	say "next: cd $project && bin/delegate spawn <worker> --cwd $project \"<task>\""
}

# cmd_list — one line per record, and whether the app has it open right now:
#
#   harness  harness  /home/mark/.pi  git  1 tabs  live sp7104110    Boss tab
#   bakmark  project  /home/mark/projects/bakmark  git  2 tabs  not in herdr-app  Boss tab
#
# `herdr-app ls` is read once. When the app is missing or its answer is not JSON, every record is
# still listed (its liveness column reads `unknown`) and one line at the end says so — a list that
# hides every space because herdr is down is worse than a list that is honest about one column.
# `--json` is the same answer for a script: each record as written, plus `live` and `live_id`.
cmd_list() {
	local json=0
	while [ "$#" -gt 0 ]; do
		case $1 in
		--json) json=1; shift ;;
		*) die "list takes no options but --json, not '$1'" ;;
		esac
	done
	command -v node >/dev/null 2>&1 || die "node is not on PATH"
	local slugs s project git tabs state kind boss live="" live_id="" snap="" unavailable=0
	slugs=$(space_slugs)
	if [ -z "$slugs" ]; then
		if [ "$json" = 1 ]; then say "[]"; else say "no spaces — bin/space new <slug> in the project folder"; fi
		return 0
	fi
	if command -v herdr-app >/dev/null 2>&1; then
		snap=$(herdr-app ls 2>/dev/null) || snap=""
	fi
	if [ -z "$snap" ]; then
		unavailable=1
	elif ! live=$(printf '%s' "$snap" | node -e '
			let d = "";
			process.stdin.on("data", (c) => (d += c)).on("end", () => {
				let j = {};
				try { j = JSON.parse(d); } catch { process.exit(3); }
				if (!j || typeof j !== "object" || !Array.isArray(j.spaces)) process.exit(3);
				for (const s of j.spaces) if (s && s.name && s.id) process.stdout.write(String(s.name) + "\t" + String(s.id) + "\n");
			});
		'); then
		unavailable=1
		live=""
	fi
	if [ "$json" = 1 ]; then
		LIVE=$live SLUGS=$slugs SPACES_DIR=$SPACES_DIR node -e '
			const fs = require("fs"), path = require("path");
			const byName = new Map();
			for (const line of String(process.env.LIVE || "").split("\n")) {
				const [name, id] = line.split("\t");
				if (name && id) byName.set(name, id);
			}
			const ids = new Set([...byName.values()]);
			const out = [];
			for (const slug of String(process.env.SLUGS || "").split("\n")) {
				if (!slug) continue;
				let rec = {};
				try { rec = JSON.parse(fs.readFileSync(path.join(process.env.SPACES_DIR, slug, "space.json"), "utf8")); } catch {}
				// The name is the handle; the herdr id is the second chance, for a record renamed in the app.
				const liveId = byName.get(slug) || (rec.id && ids.has(String(rec.id)) ? String(rec.id) : "");
				out.push(Object.assign({}, rec, { live: Boolean(liveId), live_id: liveId }));
			}
			process.stdout.write(JSON.stringify(out, null, 2) + "\n");
		'
		return 0
	fi
	while IFS= read -r s; do
		[ -n "$s" ] || continue
		project=$(space_field "$s" project)
		kind=$(space_kind "$s")
		git=$(space_field "$s" git)
		[ "$git" = true ] && git=git || git=no-git
		tabs=$(node -e '
			const fs=require("fs");let j={};try{j=JSON.parse(fs.readFileSync(process.argv[1],"utf8"))}catch{}
			process.stdout.write(String(Array.isArray(j.terminals)?j.terminals.length:0));' "$(space_record "$s")")
		boss=$(space_field "$s" boss)
		[ -n "$boss" ] || boss=Boss
		if [ "$unavailable" = 1 ]; then
			state=unknown
		else
			# The name first; herdr's id is the second chance, for a record the app renamed.
			live_id=$(printf '%s\n' "$live" | awk -F'\t' -v n="$s" '$1 == n { print $2; exit }')
			if [ -z "$live_id" ]; then
				live_id=$(space_field "$s" id)
				if [ -n "$live_id" ] && ! printf '%s\n' "$live" | awk -F'\t' -v i="$live_id" '$2 == i { found = 1 } END { exit !found }'; then
					live_id=""
				fi
			fi
			if [ -n "$live_id" ]; then state="live $live_id"; else state="not in herdr-app"; fi
		fi
		printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$s" "$kind" "$project" "$git" "$tabs tabs" "$state" "$boss tab"
	done <<<"$slugs" | awk -F'\t' '{ printf "%-20s %-8s %-40s %-7s %-8s %-18s %s\n", $1, $2, $3, $4, $5, $6, $7 }'
	[ "$unavailable" = 0 ] || printf 'herdr-app: unavailable — the liveness column says unknown, the records are all still here\n' >&2
}

cmd_show() {
	local slug=${1:-}
	[ -n "$slug" ] || usage
	space_exists "$slug" || die "no such space: $slug — bin/space list"
	node -e '
		const fs=require("fs");
		const j=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));
		const order=["name","id","project","git","remote","created","boss","boss_argv","uberboss_tab","terminals"];
		for (const k of order) if (k in j) {
			const v=j[k];
			console.log(k+": "+(Array.isArray(v)?(v.length?v.join(", "):"(none)"):(v===true?"true":v===false?"false":(v||"-"))));
		}
	' "$(space_record "$slug")"
	# Read through `space_kind` rather than printed from the record: a record written before the
	# field existed is a project space, and this is the same answer the learner gets.
	printf 'kind: %s\n' "$(space_kind "$slug")"
	printf 'specs: %s\n' "$(space_specs "$slug")"
	printf 'reports: %s\n' "$(space_reports "$slug")"
}

# cmd_forget — drop the record, and nothing else. The record is what the guard reopens from, so
# dropping it is a decision: on a terminal it is asked, and only `y`/`yes` does it. A script has
# nobody to answer, so it passes `--yes` — the question is not skipped, it is answered up front.
cmd_forget() {
	local slug="" yes=0 answer
	while [ "$#" -gt 0 ]; do
		case $1 in
		--yes | -y) yes=1; shift ;;
		-*) die "unknown option $1" ;;
		*)
			[ -z "$slug" ] || die "forget takes one space name, and '$1' is a second one"
			slug=$1
			shift
			;;
		esac
	done
	[ -n "$slug" ] || usage
	space_exists "$slug" || die "no such space: $slug — bin/space list"
	if [ "$yes" = 0 ]; then
		if [ ! -t 0 ]; then
			die "forget $slug needs an answer, and nothing here can give one — bin/space forget $slug --yes"
		fi
		printf '%s: drop its record (reports, specs, delegations stay on disk)? [y/N]: ' "$slug" >&2
		IFS= read -r answer || answer=""
		case $answer in
		y | Y | yes | YES | Yes) ;;
		*)
			say "$slug: kept — nothing was dropped"
			return 1
			;;
		esac
	fi
	# The record is dropped; the space itself is not closed, and the folder it was is said out
	# loud rather than deleted. Forgetting is about the list, not about the person's work.
	rm -f "$(space_record "$slug")"
	say "forgot $slug: dropped $(space_record "$slug") (its herdr space is still open, and $(space_dir "$slug") is still on disk)"
}

case ${1:-} in
new) shift; cmd_new "$@" ;;
list | ls) shift; cmd_list "$@" ;;
show) shift; cmd_show "$@" ;;
forget) shift; cmd_forget "$@" ;;
-h | --help | help) usage ;;
*) usage ;;
esac
