#!/usr/bin/env bash
# pr-ready — one answer to "is this pull request green", read from the rollup and never from prose.
#
#   pr-ready <pr-number> [--sha <sha>] [--min-checks N] [--wait [--interval SEC] [--max SEC] [--fail-fast]]
#
# Why it exists: `gh pr checks | grep -c pending` matches the word "pending" and nothing else, so a
# rollup of `IN_PROGRESS`, `QUEUED` or not-yet-registered checks reads as zero pending — a "green"
# on a pull request that was three minutes from going red, and it was told to the user as one. `gh
# pr checks` prose is not evidence. This reads `gh pr view <n> --json headRefOid,statusCheckRollup`
# and decides the four things that together mean green:
#
#   1. the rollup is non-empty and holds at least --min-checks (default 12) checks: two checks is a
#      workflow that has not registered the rest yet, not a green PR
#   2. nothing is pending: no empty conclusion, no status PENDING/IN_PROGRESS/QUEUED (a status
#      context's EXPECTED/PENDING state counts the same)
#   3. nothing failed: no conclusion or state FAILURE
#   4. the head is the commit that was asked about, when --sha is given — short or full, both match.
#      CI green on an older commit is not a verdict on this one.
#   5. the prose review has nothing left to answer. `prose-review` posts one comment on a PR that
#      touches an instruction file (`agent/AGENTS.md`, `agent/prompts/**`, `agent/skills/**`), and
#      that comment is green in CI whether it names five findings or five "no finding" lines. A PR
#      green on 1-4 and holding a finding is still a PR someone has to edit, so it is not handed
#      over: one line per finding, quoting the review's own words. A review this reads as
#      unreadable is not a pass either. No comment is nothing to answer — the review only speaks
#      when instruction prose changed, and it cannot speak when it was refused or not configured,
#      which a red on absence would block forever.
#
# Exit 0 only when all five hold; otherwise one status line names the numbers and a `not ready:` line
# per rule that broke, and the exit is non-zero. gh or jq missing is a FAIL, never a pass.
#
# `--wait` polls the same rule every --interval seconds (default 15) and stops when EVERY check has
# a conclusion — pending 0, checks above 0 — then judges once, appending `, finished` to the status
# line because the rollup it read is complete. A failure does not end it: a failed check tells you
# waiting cannot turn *that* one green, not what the other fourteen still running will say, and the
# reader of a wait needs all of it. Each newly-failed check is announced once as it appears
# (`check <name> failed; still waiting for <n>`), so a long wait is not silent. An empty rollup is
# "no check has registered yet", not "no checks": it keeps waiting for up to the same --max. A wait
# that runs out is not a pass. `--fail-fast` is the impatient mode and the old behaviour: stop at the
# first failure and name only it.
#
#   bin/pr-ready 209 --sha 12a731d
#   bin/pr-ready 209 --sha 12a731d --wait --max 600
#   bin/pr-ready 209 --sha 12a731d --wait --fail-fast
set -uo pipefail

prog=pr-ready
die() {
	printf '%s: %s\n' "$prog" "$*" >&2
	exit 2
}
say() { printf '%s\n' "$*"; }

usage() {
	cat >&2 <<'EOF'
usage: pr-ready <pr-number> [--sha <sha>] [--min-checks N] [--wait [--interval SEC] [--max SEC]] [--fail-fast]

Exit 0 only when the rollup holds at least --min-checks checks, none is pending, none failed, the
head is --sha when one was given, and the prose review on the PR has no finding left to answer.

--wait polls until every check has a conclusion (pending 0, checks above 0) or --max seconds run
out, then judges once: a failure does not end the wait, and each newly-failed check is named as it
appears. --fail-fast is the impatient mode: stop at the first failure and name only it. A prose
finding does not wait at all: it is answered by a commit, and no amount of polling writes one.
EOF
}

# The rollup, as five tab-separated fields: head, total, pending, fail, and the failing names
# joined on \x01 (a name can hold a space, so not a space). Every spelling gh uses for
# "not a verdict yet" is one clause, because the bug that made this file necessary was a check that
# could only see the word `pending`. `has("status")` is what keeps a StatusContext — which has a
# `state` and no conclusion at all — from reading as "conclusion is empty, so pending".
JQ_FILTER='def checks: (.statusCheckRollup // []);
def pending: ((.status // "") | test("^(PENDING|IN_PROGRESS|QUEUED|WAITING|REQUESTED)$"))
  or ((.state // "") | test("^(PENDING|EXPECTED|IN_PROGRESS|QUEUED)$"))
  or (has("status") and ((.conclusion // "") == ""));
def failed: ((.conclusion // "") == "FAILURE") or ((.state // "") == "FAILURE");
[ (.headRefOid // ""),
  (checks | length),
  (checks | map(select(pending)) | length),
  (checks | map(select(failed)) | length),
  (checks | map(select(failed)) | map(.name // .context // "unnamed") | join("\u0001")) ] | @tsv'

# read_rollup — one gh call, the four fields on stdout. Returns 1 with the reason on stdout when gh
# could not answer or its JSON did not parse: an unreadable PR is not a green one.
read_rollup() {
	local json out
	json=$("$gh_cmd" pr view "$pr" --json headRefOid,statusCheckRollup 2>&1) || {
		printf 'gh could not read PR %s: %s\n' "$pr" "$(printf '%s' "$json" | tr '\n' ' ' | cut -c1-200)"
		return 1
	}
	out=$(printf '%s' "$json" | jq -r "$JQ_FILTER" 2>&1) || {
		printf 'gh returned JSON that did not parse: %s\n' "$(printf '%s' "$out" | tr '\n' ' ' | cut -c1-200)"
		return 1
	}
	printf '%s\n' "$out"
}

# The prose review's one comment starts with this marker. `.github/scripts/prose-review.mjs` writes
# it, and the workflow finds the comment it owns by it, so it is the only thing here that says "this
# comment is the review" rather than a person quoting one.
PROSE_MARK='<!-- prose-review -->'

# prose_body — the body of the one comment that owns the marker, or the empty string when the PR has
# none. Returns 1 with the reason on stdout when gh could not answer or its JSON did not parse: a
# review nobody could read is not a review that passed.
prose_body() {
	local json body
	json=$("$gh_cmd" pr view "$pr" --json comments 2>&1) || {
		printf 'gh could not read the comments on PR %s: %s\n' "$pr" "$(printf '%s' "$json" | tr '\n' ' ' | cut -c1-200)"
		return 1
	}
	body=$(printf '%s' "$json" | jq -r --arg mark "$PROSE_MARK" \
		'[.comments[]? | (.body // "") | select(startswith($mark))] | .[0] // ""' 2>&1) || {
		printf 'gh returned comments that did not parse: %s\n' "$(printf '%s' "$body" | tr '\n' ' ' | cut -c1-200)"
		return 1
	}
	printf '%s\n' "$body"
}

# prose_findings — one line per question the review answered with something other than "no finding",
# as `<question> — <the review's own words>`. The review writes one line per question —
# `1. **contradiction** — no finding` — so a numbered line is the unit. A body with no numbered line
# at all is a review this cannot read, which is not a review that passed: it prints one line saying
# so, and the caller refuses on it.
prose_findings() {
	awk '
		/^[1-9]\. \*\*/ {
			n++
			line = $0
			sub(/^[1-9]\. \*\*/, "", line)
			at = index(line, "**")
			label = substr(line, 1, at - 1)
			line = substr(line, at + 2)
			sub(/^[[:space:]]*—[[:space:]]*/, "", line)
			if (tolower(substr(line, 1, 10)) == "no finding") next
			if (line == "") line = "(the model left this answer blank)"
			printf "%s — %s\n", label, line
		}
		END { if (n == 0 && NR > 0) print "the prose review answered nothing this gate can read" }
	'
}

# prose_ok — rule 5. Silent and 0 when there is nothing to answer; otherwise the lines a reader needs
# and 1. Cheap by construction: it is only called once the rollup has already said green, so an
# ordinary poll costs no second gh call and a PR that never touches instruction prose costs one.
prose_ok() {
	local body findings
	if ! body=$(prose_body); then
		printf '  not ready: %s\n' "$body"
		return 1
	fi
	[ -n "$body" ] || return 0
	findings=$(printf '%s\n' "$body" | prose_findings)
	[ -n "$findings" ] || return 0
	printf '  not ready: the prose review has %d answer(s) to write into the diff\n' \
		"$(printf '%s\n' "$findings" | wc -l | tr -d ' ')"
	printf '%s\n' "$findings" | sed 's/^/    - /'
	return 1
}

# head_matches <head> — the head equals --sha, short or full; no --sha is no constraint.
head_matches() {
	local h=${1,,} s=${sha,,}
	[ -n "$sha" ] || return 0
	[ "$h" = "$s" ] && return 0
	[ "${#s}" -lt "${#h}" ] && [ "${h:0:${#s}}" = "$s" ] && return 0
	return 1
}

# rollup_fields <line> — the five tab-separated fields of one rollup line, in F_HEAD, F_TOTAL,
# F_PEND, F_FAIL and F_NAMES (names joined on \x01). `read -d` splits on one byte and assigns no IFS:
# a global `IFS=` assignment is what `bash.lang.security.ifs-tampering` flags, and it is also how a
# later expansion splits on the wrong character.
rollup_fields() {
	{
		read -r -d $'\t' F_HEAD
		read -r -d $'\t' F_TOTAL
		read -r -d $'\t' F_PEND
		read -r -d $'\t' F_FAIL
		read -r -d '' F_NAMES || true
	} <<<"$1"
}

# judge <fields> — the four rules, silent.
judge() {
	local head total pend flr
	rollup_fields "$1"
	head=$F_HEAD total=$F_TOTAL pend=$F_PEND flr=$F_FAIL
	[ "$total" -gt 0 ] || return 1
	[ "$total" -ge "$min_checks" ] || return 1
	[ "$pend" -eq 0 ] || return 1
	[ "$flr" -eq 0 ] || return 1
	head_matches "$head" || return 1
	return 0
}

# report <fields> [suffix] — the one status line, then a line per rule that broke. Always returns 1:
# it is only called when the verdict is not green. The optional suffix is how a wait says the rollup
# it read is complete (`, finished`); the `checks N, pending N, fail N` shape is never changed, so a
# caller that reads those numbers keeps working.
report() {
	local head total pend flr
	rollup_fields "$1"
	head=$F_HEAD total=$F_TOTAL pend=$F_PEND flr=$F_FAIL
	printf 'pr %s: head %s, checks %d, pending %d, fail %d%s\n' "$pr" "${head:0:7}" "$total" "$pend" "$flr" "${2:-}"
	if [ "$total" -eq 0 ]; then
		if [ "$wait_for" = 1 ]; then
			say '  not ready: no check has registered yet — a rollup nobody has reported on is not a green one'
		else
			say '  not ready: no checks on the rollup yet — a PR nobody has reported on is not a green one'
		fi
	elif [ "$total" -lt "$min_checks" ]; then
		printf '  not ready: %d check(s) on the rollup, --min-checks is %d — workflows still registering are not green\n' \
			"$total" "$min_checks"
	fi
	[ "$pend" -eq 0 ] ||
		printf '  not ready: %d check(s) pending or without a conclusion yet (IN_PROGRESS, QUEUED, EXPECTED)\n' "$pend"
	[ "$flr" -eq 0 ] || printf '  not ready: %d check(s) FAILED\n' "$flr"
	if ! head_matches "$head"; then
		printf '  not ready: head is %s, asked about %s — green on another commit is not green on this one\n' \
			"${head:0:12}" "$sha"
	fi
	return 1
}

pr=""
sha=""
min_checks=12
wait_for=0
fail_fast=0
interval=15
max_wait=900
while [ "$#" -gt 0 ]; do
	case $1 in
	--sha)
		[ "$#" -ge 2 ] || die "--sha needs a value"
		sha=$2
		shift 2
		;;
	--sha=*)
		sha=${1#--sha=}
		shift
		;;
	--min-checks)
		[ "$#" -ge 2 ] || die "--min-checks needs a value"
		min_checks=$2
		shift 2
		;;
	--min-checks=*)
		min_checks=${1#--min-checks=}
		shift
		;;
	--interval)
		[ "$#" -ge 2 ] || die "--interval needs a value"
		interval=$2
		shift 2
		;;
	--interval=*)
		interval=${1#--interval=}
		shift
		;;
	--max)
		[ "$#" -ge 2 ] || die "--max needs a value"
		max_wait=$2
		shift 2
		;;
	--max=*)
		max_wait=${1#--max=}
		shift
		;;
	--wait)
		wait_for=1
		shift
		;;
	--fail-fast)
		fail_fast=1
		wait_for=1
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	-*) die "unknown option $1" ;;
	*)
		[ -z "$pr" ] || die "one PR number, not two ($pr and $1)"
		pr=$1
		shift
		;;
	esac
done

[ -n "$pr" ] || {
	usage
	exit 2
}
case $pr in *[!0-9]*) die "not a PR number: $pr" ;; esac
case $min_checks in '' | *[!0-9]*) die "--min-checks takes a number, not '$min_checks'" ;; esac
case $interval in '' | *[!0-9]* | 0) die "--interval takes a positive number of seconds" ;; esac
case $max_wait in '' | *[!0-9]*) die "--max takes a number of seconds" ;; esac

# A missing tool is a FAIL: a gate that passes because it could not look is worse than no gate.
gh_cmd=${PR_READY_GH:-gh}
command -v "$gh_cmd" >/dev/null 2>&1 || {
	printf 'pr %s: gh is not installed, so nothing here can be judged green\n' "$pr"
	exit 1
}
command -v jq >/dev/null 2>&1 || {
	printf 'pr %s: jq is not installed, so the rollup cannot be read and nothing is green\n' "$pr"
	exit 1
}

deadline=$(( $(date +%s) + max_wait ))
seen_fail=""
said_unregistered=0

# announce_failures <names-on-\x01> <pending> — one line per check that has just failed, once. A
# wait that prints nothing until it is over is a wait the reader cannot tell from a hang.
announce_failures() {
	local names=$1 pend=$2 name
	[ -n "$names" ] || return 0
	# Walked one \x01-separated name at a time with parameter expansion: no IFS assignment is needed to
	# split it, so nothing here can make a later expansion split differently.
	while [ -n "$names" ]; do
		name=${names%%$'\x01'*}
		if [ "$name" = "$names" ]; then names=""; else names=${names#*$'\x01'}; fi
		[ -n "$name" ] || continue
		printf '%s\n' "$seen_fail" | grep -Fxq -- "$name" && continue
		seen_fail="$seen_fail$name"$'\n'
		printf 'check %s failed; still waiting for %d\n' "$name" "$pend"
	done
}

while :; do
	if ! last=$(read_rollup); then
		printf 'pr %s: not ready: %s\n' "$pr" "$last"
		exit 1
	fi
	rollup_fields "$last"
	head=$F_HEAD total=$F_TOTAL pend=$F_PEND flr=$F_FAIL fail_names=$F_NAMES
	if judge "$last"; then
		finished=""
		[ "$wait_for" != 1 ] || finished=', finished'
		printf 'pr %s: head %s, checks %d, pending %d, fail %d%s\n' \
			"$pr" "${head:0:7}" "$total" "$pend" "$flr" "$finished"
		if ! prose_ok; then
			[ "$wait_for" != 1 ] || say '  stopping: a finding is answered by a commit, and waiting does not write one'
			exit 1
		fi
		exit 0
	fi
	if [ "$wait_for" != 1 ]; then
		report "$last"
		exit 1
	fi
	if [ "${flr:-0}" -gt 0 ]; then
		announce_failures "$fail_names" "$pend"
		if [ "$fail_fast" = 1 ]; then
			# The impatient mode, and the old behaviour: one failure is enough to stop and to name.
			report "$last"
			printf '  stopping: %d check(s) failed — waiting cannot turn a failure green, a new commit has to\n' "$flr"
			exit 1
		fi
	fi
	if [ "$total" -eq 0 ] && [ "$said_unregistered" = 0 ]; then
		say '  no check has registered yet; still waiting for the rollup to appear'
		said_unregistered=1
	fi
	# Every check has a conclusion: the rollup is complete, so this is the verdict and not a stop in
	# the middle of one. A failure with others still running is not that — it keeps waiting.
	if [ "$total" -gt 0 ] && [ "$pend" -eq 0 ]; then
		report "$last" ', finished'
		exit 1
	fi
	left=$((deadline - $(date +%s)))
	if [ "$left" -le 0 ]; then
		report "$last"
		printf '  gave up after --max %ss without a green rollup\n' "$max_wait"
		exit 1
	fi
	sleep_s=$interval
	[ "$left" -ge "$sleep_s" ] || sleep_s=$left
	sleep "$sleep_s"
done
