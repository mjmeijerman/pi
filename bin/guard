#!/usr/bin/env bash
# guard — the supervisor for durable spaces.
#
# bash is resolved at runtime, before anything else runs: see bin/shell-resolve.sh. It re-execs this
# script under a bash it finds when the shell that started it is not bash (cmd.exe, PowerShell, or a
# minimal Git Bash with only sh.exe), and says so when there is none.
# shellcheck source=bin/shell-resolve.sh
shell_dir=$(dirname -- "$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")")
if [ -f "$shell_dir/shell-resolve.sh" ]; then
	. "$shell_dir/shell-resolve.sh"
elif [ -z "${BASH_VERSION:-}" ]; then
	printf '%s: no shell-resolve.sh next to %s — it is what finds bash: set PI_GIT_BASH or run this under bash\n' "${0##*/}" "$0" >&2
	exit 127
fi
#
# A durable space is recorded (`state/spaces/<slug>/space.json`, written by `bin/space new`) and a
# worker is a tab in its boss's space (`kind: "tab"` in `delegations.json`). Nothing puts either
# back after it vanishes: Herdr has no per-space lock, `space.close` ends a space and its
# terminals, and a host reboot hands the tabs back as plain shells. So the space is made
# self-healing here instead — the same idea the pre-space `bin/guard` proved while there was
# one space, now driven by the records rather than by one hardcoded name.
#
# Every pass, for every recorded space:
#
#   0. identity first: a live space is this record's when its **name** matches, or, with no name
#      match, when its **folder** matches and no other record claims that folder. Herdr's id is the
#      last hint and never evidence on its own. A match is adopted — `id`, `uberboss_tab` and
#      `terminals` are rewritten from the live space — and nothing is opened. Only when nothing
#      matches is a space created, and never a second one: a live space already on this record's
#      folder, under another name, is named in the log instead of being cloned.
#   1. the space is gone from `herdr-app ls` → rebuild it with the record's own name, project
#      folder and Boss tab name, then a `tab.new` for every other tab the record lists. Never a new
#      space name, never a new project folder: the record is what the person wrote down.
#   1b. the Boss is bare. An argv that is a sandboxing wrapper (`pi`, `pisandbox`, `pi-sandboxed`),
#      or that points into the retired `~/big-boss-pi` checkout, is rewritten to this tree's
#      `bin/pi-bare` on the pass that reads it, and said once.
#   1c. a Boss is never resumed into an empty session: the tab is opened with the newest session
#      whose own `cwd` is the record's project, found by folder, not by the terminal id an entry
#      still remembers from before a reboot. A session whose first user message is a dispatch
#      (`<hc from="…`) is somebody's worker, never the Boss, and is skipped — every worker shares
#      the Boss's folder, so the newest file in it is often the last learner to finish.
#   2. the space is there but its Boss tab is not → respawn that tab with `--session <the newest
#      session for the record's project>` whenever one exists: the same conversation, and the guard
#      types nothing into a terminal itself. A tab that is there is left alone — that is the "never
#      type twice in one boot" rule, kept by not typing at all. Rebuilding (1) and respawning (2)
#      build the Boss's argv with the same helper: two paths that drifted apart left a closed space
#      coming back as an idle Boss while a killed one resumed.
#   3. a worker's tab is not the guard's business: a slug in the space's `delegations.json` is
#      resurrected only by `delegate wait --forever`, so a finished worker's tab stays closed and a
#      recorded tab carrying a worker's name is never opened here.
#   4. nothing is ever closed, renamed or moved. A supervisor that closes things is a machine that
#      deletes someone's work, so `space.close`, `tab.close`, `space.move` and any rename are not
#      words this program knows; `scripts/tests/test-guard-supervisor.sh` asserts it on the argv a
#      stub `herdr-app` saw.
#
#      The Boss tab is recognised by its ids first — `uberboss_tab`, the `terminals[]` the record
#      remembers, and the tab this program opened a moment ago — and by the name in `boss` only for
#      a tab no id answers for. A tab that carries the remembered id *is* the Boss whatever it is
#      called now, so a person renaming it is one `adopted` line and not a second tab: two Boss
#      tabs are two `pi` processes appending one session. Reading an id as a *name* is the other
#      half of that rule and still holds: a record with an id where a name belongs falls back to
#      `Boss` (`record_boss_tab`), so no tab is ever opened named `tbe0cd445bff056584e86051e0c782ea74`.
#      Adoption is keyed to the remembered id: a tab carrying it under another name is the Boss
#      renamed, and the record learns the new name. A record that remembers no id cannot tell
#      "renamed" from "gone", and reading a stranger tab as the Boss is how a dead Boss stays dead.
#   5. a space whose project folder is gone is reported by name and skipped: a space on a missing
#      folder would put the boss in a folder `git` cannot resolve. The refusal carries the command
#      that fixes it, `bin/space forget <slug>`.
#   6. a forgotten space is left alone, and so is a space in Herdr with no record — it may be
#      somebody's scratch space, and recreating what nobody recorded is how a program starts making
#      spaces for people. Nothing is opened in such a space, not even a Boss tab: the record is the
#      only thing that says a space is this program's to keep.
#
# The record gains one field, `tabs`: the Boss tab plus any extra tab the supervisor re-created,
# each `{name, folder, argv}`. `bin/space` keeps writing only what it writes today; this is a plain
# addition, and it is the only file the guard ever writes. `boss` and `boss_argv` are `bin/space`'s
# own fields, written when the space is made; a record from before them reads as `Boss` and no argv.
#
# The app is asked once per pass (`herdr-app ls`), every action is one line, and `--once` runs
# exactly one pass so a test costs a second. It runs under `env -i` with `PATH` and `HOME` because
# the runner and the sandbox both do: no git config, no login shell, no caller's environment.
#
# Radar Vol. 35: blip 20 (stateful guardrails) — a rule nothing checks is a rule that is gone.
set -uo pipefail

here=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)
# shellcheck source=bin/space-lib.sh
. "$here/space-lib.sh"
# The restore path opens the Boss tab under the record lock: two passes that read the same snapshot
# must not both open one (records-lib.sh says why a record is only ever written under that lock).
# shellcheck source=bin/records-lib.sh
. "$here/records-lib.sh"

prog=guard
INTERVAL=${PI_GUARD_INTERVAL:-20}
HERDR_APP=${PI_GUARD_HERDR_APP:-herdr-app}
RESUME_DIR=${PI_HERDR_RESUME_DIR:-${HOME:-}/.pi/agent/herdr-resume}
RESUME_SCRIPT=${PI_GUARD_RESUME_SCRIPT:-${HOME:-}/.pi/scripts/herdr-resume.mjs}
# The Boss is bare: `bin/pi-bare` in this tree, never a sandboxed wrapper and never a path into
# the retired checkout below. A record that names either is rewritten on the pass that reads it.
PI_HOME=${PI_HOME:-$(cd -- "$here/.." && pwd)}
PI_BARE=${PI_GUARD_PI_BARE:-$PI_HOME/bin/pi-bare}
# Kept for records written before the retired checkout was removed, not for anything live: a
# record that still carries its path is rewritten to this tree on the pass that reads it.
LEGACY_ROOT=${SPACE_LEGACY_ROOT:-${PI_LEGACY_BOSS_ROOT:-${HOME:-}/big-boss-pi}}
# Where a session's own folder is written down: the first line of every `*.jsonl` carries `cwd`,
# so the newest session for a project is found by reading it, not by guessing at the slug.
SESSIONS_DIR=${PI_SESSIONS_DIR:-${HOME:-}/.pi/agent/sessions}
# How long a Boss tab this program opened answers for its own absence. Two passes in the same second
# read one snapshot, so the second one's snapshot predates the tab the first one opened; the record
# keeps that tab as a claim and this is how long the claim is evidence. A claim is a moment, not a
# fact: a Boss tab that really died a minute after it was opened is still put back.
BOSS_CLAIM_SECONDS=${PI_GUARD_BOSS_CLAIM_SECONDS:-60}
ONCE=0
DRY=0
ONLY=""

say() { printf '%s: %s\n' "$prog" "$*"; }

usage() {
	cat >&2 <<'EOF'
usage: bin/guard [--once] [--space <slug>] [--dry-run]

  (no argument)   supervise every recorded space, one pass every 20 seconds
  --once          run exactly one pass and exit (what the tests call)
  --space <slug>  limit a pass to one space
  --dry-run       print the plan and call no herdr-app at all
EOF
	exit 1
}

while [ "$#" -gt 0 ]; do
	case $1 in
	--once) ONCE=1; shift ;;
	--dry-run) DRY=1; shift ;;
	--space) ONLY=${2:-}; shift 2 ;;
	-h | --help | help) usage ;;
	*) usage ;;
	esac
done
[ -z "$ONLY" ] || space_valid_slug "$ONLY" || usage

# field_of <key> — read one scalar field from the JSON on stdin.
field_of() {
	node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{let j={};try{j=JSON.parse(d)}catch{};const v=j[process.argv[1]];if(v!==undefined&&v!==null&&typeof v!=="object")process.stdout.write(String(v))})' "${1:-}"
}

# space_match <slug> — how this pass's snapshot answers for that record, as one JSON object:
#
#   {"match":"name"|"folder"|"id"|"none", "id":..., "tabs":[...]|null,
#    "live":"<the live space's name>", "other":"<a live space already on our folder>"}
#
# The name is the record's handle, so it is tried first. When no name matches, the folder decides —
# but only when no other record claims that folder: two records on one folder are told apart by
# name, and matching both of them by folder would hand one record the other's space. Herdr's id is
# the last hint, and a hint only: a live space whose name or folder another record claims is not
# adopted, however familiar the id looks.
#
# `other` is what makes "never a second space for one folder" a fact rather than an intention: a
# live space already sitting on our project, and not ours by name, is named in the log instead of
# being cloned. Nothing here writes or opens anything — the caller decides.
space_match() {
	printf '%s' "$SNAP" | RECORD=$(space_record "${1:-}") SPACES_DIR=$SPACES_DIR SLUG=${1:-} node -e '
		const fs = require("fs"), path = require("path");
		let d = "";
		process.stdin.on("data", (c) => (d += c)).on("end", () => {
			const out = { match: "none", id: "", tabs: null, live: "", other: "" };
			let rec = {};
			try { rec = JSON.parse(fs.readFileSync(process.env.RECORD, "utf8")); } catch { process.stdout.write(JSON.stringify(out)); return; }
			const name = String(rec.name || ""), project = String(rec.project || ""), id = String(rec.id || "");
			const byName = new Map(), byFolder = new Map();
			let names = [];
			try { names = fs.readdirSync(process.env.SPACES_DIR); } catch {}
			for (const n of names) {
				let r = {};
				try { r = JSON.parse(fs.readFileSync(path.join(process.env.SPACES_DIR, n, "space.json"), "utf8")); } catch { continue; }
				const rn = String(r.name || ""), rp = String(r.project || "");
				if (rn && !byName.has(rn)) byName.set(rn, n);
				if (rp) byFolder.set(rp, (byFolder.get(rp) || []).concat(n));
			}
			let j = {};
			try { j = JSON.parse(d); } catch { process.stdout.write(JSON.stringify(out)); return; }
			const spaces = (Array.isArray(j.spaces) ? j.spaces : []).filter((s) => s && typeof s === "object");
			const mine = process.env.SLUG || "";
			let hit = spaces.find((s) => String(s.name || "") === name);
			if (hit) out.match = "name";
			if (!hit && project) {
				const otherRecords = (byFolder.get(project) || []).filter((n) => n !== mine);
				if (otherRecords.length === 0) {
					hit = spaces.find((s) => String(s.folder || "") === project);
					if (hit) out.match = "folder";
				}
			}
			if (!hit && id) {
				const cand = spaces.find((s) => String(s.id || "") === id);
				if (cand) {
					const cn = String(cand.name || ""), cf = String(cand.folder || "");
					const claimed =
						(cn && byName.has(cn) && byName.get(cn) !== mine) ||
						(cf && (byFolder.get(cf) || []).some((n) => n !== mine));
					if (!claimed) { hit = cand; out.match = "id"; }
				}
			}
			if (hit) {
				out.id = String(hit.id || "");
				out.tabs = Array.isArray(hit.tabs) ? hit.tabs : null;
				out.live = String(hit.name || "");
			} else if (project) {
				const squat = spaces.find((s) => String(s.folder || "") === project);
				if (squat) out.other = String(squat.name || "") || String(squat.id || "") || "(unnamed)";
			}
			process.stdout.write(JSON.stringify(out));
		});'
}

# adopt_space <slug> <match-json> — the live space is this record's, so herdr's own ids are what
# the record learns: `id`, the Boss tab's id and the terminals that tab holds. Printed is what
# changed, in words, or nothing when the record already agreed (a pass that finds agreement writes
# nothing, so the file is not rewritten every 20 seconds).
adopt_space() {
	RECORD=$(space_record "${1:-}") MATCH=${2:-} node -e '
		const fs = require("fs");
		let m = {};
		try { m = JSON.parse(process.env.MATCH || "{}"); } catch { process.exit(0); }
		let r = {};
		try { r = JSON.parse(fs.readFileSync(process.env.RECORD, "utf8")); } catch { process.exit(0); }
		const said = [];
		if (m.id && String(r.id || "") !== String(m.id)) {
			said.push("id " + (r.id ? String(r.id) : "(none)") + " -> " + String(m.id));
			r.id = String(m.id);
		}
		const boss = String(r.boss || "Boss");
		const tab = (Array.isArray(m.tabs) ? m.tabs : []).find(
			(t) => t && typeof t === "object" && String(t.name ?? t.title ?? "") === boss,
		);
		if (tab) {
			const tid = String(tab.id ?? tab.tab ?? "");
			if (tid && String(r.uberboss_tab || "") !== tid) {
				said.push("uberboss_tab -> " + tid);
				r.uberboss_tab = tid;
			}
			// Only a tab list that says who is in the tab is written down: an app that answered
			// without `terminals` is "cannot tell", and erasing a terminal id there would lose the
			// resume entry that names it.
			if (Array.isArray(tab.terminals)) {
				const terms = tab.terminals
					.map((t) => (typeof t === "string" ? t : String(t?.terminal ?? t?.id ?? "")))
					.filter(Boolean);
				if (JSON.stringify(terms) !== JSON.stringify(Array.isArray(r.terminals) ? r.terminals : [])) {
					said.push("terminals -> " + (terms.length ? terms.join(",") : "(none)"));
					r.terminals = terms;
				}
			}
		}
		if (!said.length) process.exit(0);
		fs.writeFileSync(process.env.RECORD, JSON.stringify(r, null, 2) + "\n");
		process.stdout.write(said.join("; "));
	'
}

# normalise_boss_argv <slug> — a record that would bring the Boss back sandboxed is rewritten to
# `bin/pi-bare`, and what was rewritten is printed once (one line for the whole record). Two shapes
# count: a sandboxing wrapper first (`pi`, `pisandbox`, `pi-sandboxed` — `pi` on PATH is install.sh's
# sandboxing entry point), and any argument pointing into the retired checkout, whose
# `bin/pi-bare` no longer exists.
normalise_boss_argv() {
	RECORD=$(space_record "${1:-}") BARE=$PI_BARE LEGACY=$LEGACY_ROOT node -e '
		const fs = require("fs");
		let r = {};
		try { r = JSON.parse(fs.readFileSync(process.env.RECORD, "utf8")); } catch { process.exit(0); }
		const bare = process.env.BARE || "";
		const legacy = (process.env.LEGACY || "").replace(/\/+$/, "");
		if (!bare) process.exit(0);
		const sandboxed = (a) => {
			if (!Array.isArray(a) || !a.length) return false;
			const first = String(a[0] || "");
			if (["pi", "pisandbox", "pi-sandboxed"].includes(first.split("/").pop())) return true;
			return Boolean(legacy) && a.some((x) => typeof x === "string" && (x === legacy || x.startsWith(legacy + "/")));
		};
		const said = [];
		if (sandboxed(r.boss_argv)) { said.push("boss_argv"); r.boss_argv = [bare]; }
		for (const t of Array.isArray(r.tabs) ? r.tabs : []) {
			if (t && typeof t === "object" && sandboxed(t.argv)) {
				said.push("tab " + String(t.name || "(unnamed)"));
				t.argv = [bare];
			}
		}
		if (!said.length) process.exit(0);
		fs.writeFileSync(process.env.RECORD, JSON.stringify(r, null, 2) + "\n");
		process.stdout.write(said.join(", "));
	'
}

# newest_session <project> — the newest session whose own `cwd` is that project, by file time. Found
# by folder, never by terminal id: the resume entry that carries a dead terminal's id is exactly
# what made a Boss come back as an empty `pi` (the session was never opened). Nothing found is an
# empty answer, and the caller then falls back to the resume entry.
#
# A session whose first user message is a dispatch — `<hc from="…"` is how `bin/delegate` and
# `agent-pane.sh` hand a worker its spec — is not the Boss's transcript. Every learner and worker
# shares the Boss's project folder, so one that finished after the Boss is the newest match, and a
# rebuild would open the Boss on a worker's conversation.
newest_session() {
	local project=${1:-}
	[ -n "$project" ] || return 0
	command -v node >/dev/null 2>&1 || return 0
	PI_SESSIONS_DIR=$SESSIONS_DIR SESSION_PROJECT=$project node -e '
		const fs = require("fs"), path = require("path");
		const dir = process.env.PI_SESSIONS_DIR || "", want = process.env.SESSION_PROJECT || "";
		if (!dir || !want) process.exit(0);
		const DISPATCH = /^\s*<hc\s+from=/;
		// The first user message, read line by line until it turns up: a session starts with a few
		// header lines, and a whole 8 KiB head is not always enough to reach the first prompt.
		function firstUserText(p) {
			let text = "";
			const lines = fs.readFileSync(p, "utf8").split("\n");
			for (const line of lines) {
				if (!line.trim()) continue;
				let o;
				try { o = JSON.parse(line); } catch { continue; }
				if (!o || o.type !== "message" || !o.message || o.message.role !== "user") continue;
				const c = o.message.content;
				if (typeof c === "string") { text = c; break; }
				if (Array.isArray(c)) {
					text = c.filter((b) => b && b.type === "text").map((b) => String(b.text || "")).join("");
					break;
				}
			}
			return text;
		}
		let folders = [];
		try { folders = fs.readdirSync(dir); } catch { process.exit(0); }
		let best = null;
		for (const folder of folders) {
			let files = [];
			try { files = fs.readdirSync(path.join(dir, folder)).filter((f) => f.endsWith(".jsonl")); } catch { continue; }
			for (const f of files) {
				const p = path.join(dir, folder, f);
				let cwd = "";
				try {
					const fd = fs.openSync(p, "r");
					const buf = Buffer.alloc(8192);
					const n = fs.readSync(fd, buf, 0, 8192, 0);
					fs.closeSync(fd);
					const head = buf.subarray(0, n).toString("utf8").split("\n")[0];
					cwd = String(JSON.parse(head).cwd || "");
				} catch { continue; }
				if (cwd !== want) continue;
				try { if (DISPATCH.test(firstUserText(p))) continue; } catch { continue; }
				let st;
				try { st = fs.statSync(p); } catch { continue; }
				if (!best || st.mtimeMs >= best.at) best = { at: st.mtimeMs, p };
			}
		}
		if (best) process.stdout.write(best.p);
	'
}

# boss_session <slug> <project> — the session a Boss tab opens with: the newest for the record's
# project, or the path a resume entry names when the folder holds none.
boss_session() {
	local slug=$1 project=$2 session entry
	session=$(newest_session "$project")
	if [ -z "$session" ]; then
		entry=$(resume_entry "$slug")
		[ -z "$entry" ] || session=$(printf '%s' "$entry" | field_of session_path)
	fi
	printf '%s' "$session"
}

# boss_argv_with_session <slug> <boss> <session> — the argv both resume paths open the Boss tab
# with: the record's own command (never a resume entry's, and never a wrapper), exactly one
# `--session`, and the newest session when there is one. One helper for both paths because the
# two drifting apart is the bug: `restore_boss` resumed the conversation and `rebuild_space` did
# not, so a closed space came back as a brand-new idle Boss.
boss_argv_with_session() {
	local base
	base=$(boss_argv_json "${1:-}" "${2:-Boss}")
	BASE=$base BARE=$PI_BARE SESSION=${3:-} node -e '
		let a = [];
		try { a = JSON.parse(process.env.BASE || "[]"); } catch {}
		if (!Array.isArray(a) || !a.length) a = process.env.BARE ? [process.env.BARE] : [];
		const out = [];
		for (let i = 0; i < a.length; i++) {
			if (a[i] === "--session") { i++; continue; }
			out.push(a[i]);
		}
		const s = process.env.SESSION || "";
		if (s) out.push("--session", s);
		process.stdout.write(JSON.stringify(out));'
}

# boss_argv_json <slug> <boss> — the argv the Boss tab is opened with, as JSON: the record's own, or
# `bin/pi-bare` when the record keeps none, because a Boss that comes back as a bare shell (or as a
# sandboxed `pi`) is the thing this record exists to prevent.
boss_argv_json() {
	local argv
	argv=$(boss_argv "${1:-}" "${2:-Boss}")
	if [ -n "$argv" ]; then
		printf '%s' "$argv"
		return 0
	fi
	BARE=$PI_BARE node -e 'process.stdout.write(JSON.stringify(process.env.BARE ? [process.env.BARE] : []))'
}

# boss_present <slug> — is the record's Boss tab in this space? stdin is `space_match`'s answer.
#   yes        the tab is there: by an id the record remembers (`uberboss_tab`, `terminals[]`, or the
#              tab this program opened a moment ago), or by the name the record keeps in `boss`
#   adopt:<n>  a tab carries an id the record remembers and answers to another name `<n>`: it is the
#              Boss, renamed by the person, and the caller writes the name down instead of opening one
#   no         the space has tabs and none of them is the Boss tab
#   unknown    the app answered with no tab list, or with tabs whose names and ids say nothing:
#              a guard that guesses here re-opens the Boss tab every 20 seconds forever
#
# The ids come first and the name last: `uberboss_tab` and `terminals[]` are what herdr said the Boss
# tab is, and renaming a tab does not change which tab holds the conversation. Reading the name first
# — and reading an id only for a tab the app gave no name — is what put a second Boss tab beside the
# first one whenever the record's name and the tab's label drifted apart: two `pi` processes
# appending one session file.
boss_present() {
	RECORD=$(space_record "${1:-}") CLAIM_MS=$((${BOSS_CLAIM_SECONDS:-60} * 1000)) node -e '
		const fs = require("fs");
		let d = "";
		process.stdin.on("data", (c) => (d += c)).on("end", () => {
			let s = {};
			try { s = JSON.parse(d); } catch { process.stdout.write("unknown"); return; }
			const tabs = Array.isArray(s.tabs) ? s.tabs : null;
			if (tabs === null) { process.stdout.write("unknown"); return; }
			let r = {};
			try { r = JSON.parse(fs.readFileSync(process.env.RECORD, "utf8")); } catch {}
			const boss = String(r.boss || "Boss");
			const claim = r.boss_claim && typeof r.boss_claim === "object" ? r.boss_claim : null;
			const at = claim ? Date.parse(String(claim.at || "")) : NaN;
			const claimMs = Number(process.env.CLAIM_MS || 0);
			const age = Number.isFinite(at) ? Date.now() - at : -1;
			const fresh = claimMs > 0 && age >= 0 && age <= claimMs;
			// The tab this program opened itself is one of the ids that answer for the Boss, while
			// the claim lasts: an older claim names a dead terminal and says nothing.
			const ids = new Set(
				[String(r.uberboss_tab || "")]
					.concat(Array.isArray(r.terminals) ? r.terminals.map(String) : [])
					.concat(fresh && claim ? [String(claim.tab || ""), String(claim.terminal || "")] : [])
					.filter(Boolean),
			);
			const own = (t) => {
				const list = [t.id, t.tab, t.terminal].filter((v) => typeof v === "string");
				if (Array.isArray(t.terminals)) {
					for (const x of t.terminals) list.push(typeof x === "string" ? x : String(x?.id ?? x?.terminal ?? ""));
				}
				return list.filter(Boolean);
			};
			let identifiable = false;
			// 1. an id the record remembers: that tab is the Boss whatever it is called now.
			for (const t of tabs) {
				if (!t || typeof t !== "object") continue;
				const mine = own(t);
				const name = String(t.name ?? t.title ?? "");
				if (name || mine.length) identifiable = true;
				if (!mine.some((v) => ids.has(v))) continue;
				process.stdout.write(!name || name === boss ? "yes" : "adopt:" + name);
				return;
			}
			// 2. a tab this program opened a moment ago, on a snapshot taken before it existed.
			if (fresh) { process.stdout.write("yes"); return; }
			if (tabs.length === 0) { process.stdout.write("no"); return; }
			// 3. the name the record keeps, for the app that hands us names and no ids.
			for (const t of tabs) {
				if (!t || typeof t !== "object") continue;
				if (String(t.name ?? t.title ?? "") === boss) { process.stdout.write("yes"); return; }
			}
			// Nothing above answered, so the space has tabs and none of them is the Boss: the Boss
			// tab is gone. A single named tab that carries none of the remembered ids is that same
			// answer: a record which remembers no id cannot tell "renamed" from "gone", and guessing
			// "renamed" is what keeps a dead Boss dead forever.
			process.stdout.write(identifiable ? "no" : "unknown");
		});'
}

# adopt_boss_name <slug> <name> — the Boss tab answers to another name now, so the record learns it:
# `boss`, and the `tabs[]` entry that carried the old name (or the first entry, or a new one). The
# argv already recorded for the Boss tab is kept — a name is what was renamed, not how it starts.
adopt_boss_name() {
	RECORD=$(space_record "${1:-}") NEWNAME=${2:-} node -e '
		const fs = require("fs");
		let r = {};
		try { r = JSON.parse(fs.readFileSync(process.env.RECORD, "utf8")); } catch { process.exit(1); }
		const name = String(process.env.NEWNAME || "");
		if (!name) process.exit(1);
		const old = String(r.boss || "Boss");
		if (old === name) process.exit(1);
		r.boss = name;
		const tabs = Array.isArray(r.tabs) ? r.tabs : [];
		const at = tabs.findIndex((t) => t && typeof t === "object" && String(t.name || "") === old);
		if (at >= 0) tabs[at].name = name;
		else if (tabs.length && tabs[0] && typeof tabs[0] === "object") tabs[0].name = name;
		else tabs.push({ name, folder: String(r.project || ""), argv: [] });
		r.tabs = tabs;
		fs.writeFileSync(process.env.RECORD, JSON.stringify(r, null, 2) + "\n");
	'
}

# record_boss_claim <slug> <tab.new's answer> — the Boss tab this pass just opened, and when, so the
# pass that comes next opens nothing against a snapshot older than the tab. `boss_present` decides
# how long a claim answers (PI_GUARD_BOSS_CLAIM_SECONDS); the lock in `restore_boss` is what lets the
# pass that was waiting read this claim instead of its own stale answer.
record_boss_claim() {
	RECORD=$(space_record "${1:-}") ANSWER=${2:-} node -e '
		const fs = require("fs");
		let r = {};
		try { r = JSON.parse(fs.readFileSync(process.env.RECORD, "utf8")); } catch { process.exit(0); }
		let a = {};
		try { a = JSON.parse(process.env.ANSWER || "{}"); } catch {}
		r.boss_claim = {
			tab: typeof a?.tab === "string" ? a.tab : "",
			terminal: typeof a?.terminal === "string" ? a.terminal : "",
			at: new Date().toISOString(),
		};
		fs.writeFileSync(process.env.RECORD, JSON.stringify(r, null, 2) + "\n");
	'
}

# resume_entry <slug> — the newest resume entry that belongs to this space's Boss tab, as JSON
# `{session_path, argv}`, or nothing. Read by terminal id first (the entry the extension wrote for
# that tab), then by the space id plus the project folder (after a reboot the parked tab can lose
# its terminal). An entry whose session file is gone is not an answer.
resume_entry() {
	RECORD=$(space_record "${1:-}") RESUME_DIR=$RESUME_DIR node -e '
		const fs = require("fs"), path = require("path");
		let r = {};
		try { r = JSON.parse(fs.readFileSync(process.env.RECORD, "utf8")); } catch { process.exit(0); }
		const ids = new Set((Array.isArray(r.terminals) ? r.terminals : []).map(String));
		let names = [];
		try { names = fs.readdirSync(process.env.RESUME_DIR).filter((n) => n.endsWith(".json")); } catch { process.exit(0); }
		let best = null;
		for (const n of names) {
			let e = {};
			try { e = JSON.parse(fs.readFileSync(path.join(process.env.RESUME_DIR, n), "utf8")); } catch { continue; }
			if (!e || typeof e.session_path !== "string" || !Array.isArray(e.argv) || e.argv.length === 0) continue;
			if (!fs.existsSync(e.session_path)) continue;
			const byTerminal = typeof e.terminal === "string" && ids.has(e.terminal);
			const bySpace = Boolean(r.id) && e.space === r.id && e.cwd === r.project;
			if (!byTerminal && !bySpace) continue;
			const at = String(e.updated_at || "");
			if (!best || at > best.at) best = { at, entry: e };
		}
		if (!best) process.exit(0);
		process.stdout.write(JSON.stringify({ session_path: best.entry.session_path, argv: best.entry.argv }));
	'
}

# record_extras <slug> <boss name> — one TSV line per recorded tab that is not the Boss and not a
# worker: `name<TAB>folder<TAB>argv-json`. A tab named after a slug in `delegations.json` is a
# worker's tab, and a worker's tab is `delegate wait --forever`'s to bring back, not this program's.
record_extras() {
	RECORD=$(space_record "${1:-}") DELEGATIONS=$(space_delegations "${1:-}") node -e '
		const fs = require("fs");
		let r = {};
		try { r = JSON.parse(fs.readFileSync(process.env.RECORD, "utf8")); } catch { process.exit(0); }
		let d = {};
		try { d = JSON.parse(fs.readFileSync(process.env.DELEGATIONS, "utf8")); } catch {}
		const boss = process.argv[1];
		for (const t of Array.isArray(r.tabs) ? r.tabs : []) {
			if (!t || typeof t !== "object") continue;
			const name = String(t.name || "");
			if (!name || name === boss) continue;
			if (d && Object.prototype.hasOwnProperty.call(d, name)) continue;
			const folder = String(t.folder || r.project || "");
			const argv = Array.isArray(t.argv) && t.argv.length ? JSON.stringify(t.argv) : "";
			process.stdout.write([name, folder, argv].join("\t") + "\n");
		}
	' "${2:-Boss}"
}

# record_tabs_seed <slug> — give a record written before this field existed its `tabs` list, once.
# A plain addition: every other field is left exactly as `bin/space` wrote it.
record_tabs_seed() {
	RECORD=$(space_record "${1:-}") node -e '
		const fs = require("fs");
		let r = {};
		try { r = JSON.parse(fs.readFileSync(process.env.RECORD, "utf8")); } catch { process.exit(0); }
		if (Array.isArray(r.tabs) && r.tabs.length) process.exit(0);
		r.tabs = [{ name: String(r.boss || "Boss"), folder: String(r.project || ""), argv: [] }];
		fs.writeFileSync(process.env.RECORD, JSON.stringify(r, null, 2) + "\n");
	'
}

# boss_argv <slug> <boss name> — the argv the record kept for the Boss tab, or nothing.
boss_argv() {
	RECORD=$(space_record "${1:-}") node -e '
		const fs = require("fs");
		let r = {};
		try { r = JSON.parse(fs.readFileSync(process.env.RECORD, "utf8")); } catch { process.exit(0); }
		const want = process.argv[1];
		const hit = (Array.isArray(r.tabs) ? r.tabs : []).find((t) => t && t.name === want);
		if (hit && Array.isArray(hit.argv) && hit.argv.length) process.stdout.write(JSON.stringify(hit.argv));
		// `boss_argv` is what `bin/space new` opened the tab with; a `tabs[]` entry can carry an empty
		// argv and must not shadow it, or the rebuilt Boss tab comes back as a bare shell.
		else if (Array.isArray(r.boss_argv) && r.boss_argv.length) process.stdout.write(JSON.stringify(r.boss_argv));
	' "${2:-Boss}"
}

# record_boss_tab <slug> [argv-json] — remember the Boss tab the supervisor just opened, so the
# next rebuild starts it the same way.
#
# The name comes from `boss` and never from `uberboss_tab`: that field is the tab's herdr **id**,
# and reading it as a name is what put a tab literally named `tbe0cd445bff056584e86051e0c782ea74`
# in this space once. An id, a bare number or the record's own id is not a tab name, so a record
# that has one where the name should be falls back to `Boss` and no id is ever written down as
# a tab. An empty argv keeps the argv already recorded for that tab instead of erasing it.
record_boss_tab() {
	RECORD=$(space_record "${1:-}") BOSS_ARGV=${2:-} node -e '
		const fs = require("fs");
		let r = {};
		try { r = JSON.parse(fs.readFileSync(process.env.RECORD, "utf8")); } catch { process.exit(0); }
		const ids = new Set(
			[String(r.uberboss_tab || ""), String(r.id || "")]
				.concat(Array.isArray(r.terminals) ? r.terminals.map(String) : [])
				.filter(Boolean),
		);
		const idish = (s) => !s || ids.has(s) || /^[0-9]+$/.test(s) || /^[a-z]{1,3}[0-9a-f]{6,}$/i.test(s);
		const named = String(r.boss || "Boss");
		const name = idish(named) ? "Boss" : named;
		let argv = [];
		try { argv = JSON.parse(process.env.BOSS_ARGV || "[]"); } catch {}
		argv = Array.isArray(argv) ? argv : [];
		const opened = argv.slice();
		const tabs = Array.isArray(r.tabs) ? r.tabs : [];
		const at = tabs.findIndex((t) => t && t.name === name);
		if (!argv.length && at >= 0 && Array.isArray(tabs[at].argv)) argv = tabs[at].argv;
		const entry = { name, folder: String(r.project || ""), argv };
		if (at < 0) tabs.push(entry);
		else tabs[at] = entry;
		r.tabs = tabs;
		// A tab this program opened writes the argv it opened in both places the record keeps one:
		// a boss_argv left saying something else is what the next resume reads back. No argv passed
		// means nothing was opened, and then the record is left as it is.
		if (opened.length) r.boss_argv = argv;
		const next = JSON.stringify(r, null, 2) + "\n";
		const now = fs.readFileSync(process.env.RECORD, "utf8");
		if (next !== now) fs.writeFileSync(process.env.RECORD, next);
	'
}

# tab_new <space id> <name> <folder> [argv-json] — the one way this program opens a tab. No colour
# of close, no rename, no move: the app is only ever asked to add.
tab_new() {
	local sid=${1:-} tname=${2:-} folder=${3:-} argv=${4:-}
	# `--focus false` always: the supervisor runs on a timer, and a tab it opens for its own repair
	# must never take the keyboard away from whoever is reading a pull request.
	if [ -n "$argv" ]; then
		"$HERDR_APP" do tab.new --name "$tname" --space "$sid" --folder "$folder" --argv "$argv" --focus false
	else
		"$HERDR_APP" do tab.new --name "$tname" --space "$sid" --folder "$folder" --focus false
	fi
}

# resume_sweep — after a space was rebuilt, let `scripts/herdr-resume.mjs` put back whatever parked
# terminal it can. Not reimplemented here: that script owns the typing, the "already restored this
# boot" mark and the pruning, and a second copy of those rules is how two programs start disagreeing
# about whether a session is already running.
resume_sweep() {
	local out
	[ -f "$RESUME_SCRIPT" ] || return 0
	command -v node >/dev/null 2>&1 || return 0
	out=$(PI_HERDR_RESUME_WAIT_MS=${PI_GUARD_RESUME_WAIT_MS:-1500} \
		PI_HERDR_RESUME_ENTRY_MS=${PI_GUARD_RESUME_ENTRY_MS:-2000} \
		PI_HERDR_RESUME_START_MS=${PI_GUARD_RESUME_START_MS:-2000} \
		node "$RESUME_SCRIPT" 2>&1) || true
	case $out in
	*"restored terminal "*) say "harness: herdr-resume restored $(printf '%s\n' "$out" | grep -c 'restored terminal ') session(s)" ;;
	esac
}

# rebuild_space <slug> <name> <boss> — the space itself is gone: make it again exactly as the
# record says, then the tabs the record lists.
rebuild_space() {
	local slug=$1 name=$2 boss=$3 project out spaceid extras tname tfolder targv count bossargv session
	project=$(space_field "$slug" project)
	extras=$(record_extras "$slug" "$boss")
	count=1
	[ -z "$extras" ] || count=$((1 + $(printf '%s\n' "$extras" | grep -c .)))
	# The Boss tab's own argv is passed on to `space.new`, the same way `bin/space new` does it: a
	# rebuilt Boss tab that comes back as a bare shell is the thing this record exists to prevent,
	# and a record that keeps none is opened bare rather than sandboxed.
	# The command is built by the same helper `restore_boss` uses, session included: a space a
	# person closed came back as an idle Boss on a new session while a killed Boss resumed, and
	# that difference was this path not asking for a session at all.
	session=$(boss_session "$slug" "$project")
	bossargv=$(boss_argv_with_session "$slug" "$boss" "$session")
	if [ -n "$bossargv" ]; then
		out=$("$HERDR_APP" do space.new --name "$name" --folder "$project" --tab "$boss" --argv "$bossargv" --focus false 2>&1) || {
			say "harness: space.new failed for $name: $out"
			return 0
		}
	else
		out=$("$HERDR_APP" do space.new --name "$name" --folder "$project" --tab "$boss" --focus false 2>&1) || {
			say "harness: space.new failed for $name: $out"
			return 0
		}
	fi
	say "harness: space gone, recreating with $count tabs"
	# Which conversation came back, so the choice is visible and a wrong one is one line away.
	if [ -n "$session" ]; then
		say "harness: $name: Boss tab resumes session $session"
	else
		say "harness: $name: no session to resume, Boss tab starts a new one"
	fi
	spaceid=$(printf '%s' "$out" | field_of space)
	# The argv the tab was opened with is what the record now keeps for it.
	record_boss_tab "$slug" "$bossargv"
	if [ -n "$extras" ]; then
		while IFS=$'\t' read -r tname tfolder targv; do
			[ -n "$tname" ] || continue
			[ -n "$tfolder" ] || tfolder=$project
			if [ -n "$spaceid" ] && tab_new "$spaceid" "$tname" "$tfolder" "$targv" >/dev/null 2>&1; then
				say "harness: tab $tname recreated in $name"
			else
				say "harness: tab.new failed for $tname in $name"
			fi
		done <<<"$extras"
	fi
	resume_sweep
}

# restore_boss <slug> <name> <boss> <space> — the space is there and its Boss tab is not.
restore_boss() {
	local slug=$1 name=$2 boss=$3 space="$4" project spaceid session argv rec present out rc
	project=$(space_field "$slug" project)
	spaceid=$(printf '%s' "$space" | field_of id)
	rec=$(space_record "$slug")
	# Two passes in the same second read "no Boss tab" out of one snapshot and would both open one —
	# two `pi` appending one session, 631 ms apart, is what that looked like. So the decision is
	# taken under the record lock and re-asked of the record that is there when the lock is ours: the
	# pass that went first left a claim naming the tab it opened, `boss_present` reads it as `yes`,
	# and this pass opens nothing. The lock is held across `tab.new` on purpose — a lock released
	# before the answer is a lock that never saw it.
	if ! records_lock "$rec"; then
		say "harness: $name: the record stayed locked, so no Boss tab was opened this pass"
		return 0
	fi
	present=$(printf '%s' "$space" | boss_present "$slug")
	if [ "$present" != no ]; then
		records_unlock "$rec"
		say "harness: $name: another pass has the Boss tab in hand ($present), so not a second one"
		return 0
	fi
	# The session is found by the record's project folder, not by the terminal an entry happens to
	# name: after a reboot the parked tab carries the dead terminal's id, and a stale id is not a
	# reason to hand the Boss an empty session when the real conversation is on disk.
	session=$(boss_session "$slug" "$project")
	# The Boss's command is the record's, never the resume entry's. An entry written before the
	# bare-Boss rule carries `["pi"]` — or a sandbox wrapper — and using it as the base hands the
	# person a sandboxed Boss on every resume, which `record_boss_tab` then spreads into the record.
	# A flag in an entry is the same stale trust as an interpreter in an entry, so the entry says
	# nothing about the command either. It is only asked for a session path when the folder has none.
	# One `--session`, and the newest one: the helper drops one the record already carried.
	argv=$(boss_argv_with_session "$slug" "$boss" "$session")
	out=$(tab_new "$spaceid" "$boss" "$project" "$argv" 2>&1)
	rc=$?
	if [ "$rc" -eq 0 ]; then
		if [ -n "$session" ]; then
			say "harness: Boss tab resumed from session $session"
		else
			say "harness: Boss tab recreated in $name, no session to resume"
		fi
		record_boss_tab "$slug" "$argv"
		# The tab's own ids, and the second this pass opened it: what the waiting pass reads.
		record_boss_claim "$slug" "$out"
	else
		say "harness: tab.new failed for the Boss tab of $name"
	fi
	records_unlock "$rec"
}

# one_space <slug> — everything one pass does about one space.
one_space() {
	local slug=$1 name project boss match mid other present chg
	if ! space_exists "$slug"; then
		say "$slug: no record, left alone — bin/space list"
		return 0
	fi
	name=$(space_field "$slug" name)
	[ -n "$name" ] || name=$slug
	boss=$(space_field "$slug" boss)
	[ -n "$boss" ] || boss=Boss
	project=$(space_field "$slug" project)
	if [ -z "$project" ] || [ ! -d "$project" ]; then
		say "$name: project folder is gone, skipped — bin/space forget $slug if you mean it"
		return 0
	fi
	if [ "$DRY" = 1 ]; then
		match=$(space_match "$slug")
		mid=$(printf '%s' "$match" | field_of id)
		other=$(printf '%s' "$match" | field_of other)
		if [ -n "$other" ]; then
			say "$name: dry-run: the space '$other' is already open on $project, so no space.new"
		elif [ -n "$mid" ]; then
			say "$name: dry-run: keeps herdr's space $mid with its Boss tab '$boss' on $project, no space.new"
		else
			say "$name: dry-run: would keep space '$name' on $project with its Boss tab '$boss' and its recorded tabs"
		fi
		return 0
	fi
	# A Boss that would come back sandboxed, or from the retired checkout, is rewritten before
	# anything is opened: the record is what a reboot replays.
	chg=$(normalise_boss_argv "$slug")
	[ -z "$chg" ] || say "$name: Boss argv was not bare ($chg), recorded $PI_BARE"
	record_tabs_seed "$slug"
	match=$(space_match "$slug")
	mid=$(printf '%s' "$match" | field_of id)
	if [ -z "$mid" ]; then
		other=$(printf '%s' "$match" | field_of other)
		if [ -n "$other" ]; then
			say "$name: a space on $project is already open as '$other' — not cloning it (bin/space forget $slug if this record is stale)"
			return 0
		fi
		rebuild_space "$slug" "$name" "$boss"
		return 0
	fi
	# The live space is this record's: herdr's ids are adopted into the record and nothing opens.
	chg=$(adopt_space "$slug" "$match")
	[ -z "$chg" ] || say "$name: adopted herdr's space $mid: $chg"
	present=$(printf '%s' "$match" | boss_present "$slug")
	case $present in
	yes)
		# A Boss tab that is there is recorded, never opened again: the next pass must find the
		# same tab by name, and an empty argv keeps whatever argv the record already has.
		record_boss_tab "$slug" ""
		return 0
		;;
	unknown)
		say "$name: herdr-app listed no tab names or ids for it, left alone"
		return 0
		;;
	adopt:*)
		# The tab carries the id the record remembers and answers to another name: the person
		# renamed it. Writing the name down is the whole repair — opening a Boss tab beside it is
		# a second `pi` appending the same session.
		chg=${present#adopt:}
		if adopt_boss_name "$slug" "$chg"; then
			say "$name: adopted '$chg' as the Boss tab's name — the tab carries the id the record remembers, so it is the same Boss"
			boss=$chg
			record_boss_tab "$slug" ""
		else
			say "$name: the Boss tab is called '$chg' now, and the record could not be written"
		fi
		return 0
		;;
	esac
	restore_boss "$slug" "$name" "$boss" "$match"
}

# pass — one sweep over the records, with the app asked once.
pass() {
	local slugs slug
	if command -v "$HERDR_APP" >/dev/null 2>&1; then
		SNAP=$("$HERDR_APP" ls 2>/dev/null) || SNAP=""
	else
		SNAP=""
	fi
	if [ "$DRY" = 0 ] && [ -z "$SNAP" ]; then
		say "harness: herdr-app did not answer, so no space can be supervised — is the app running?"
		return 0
	fi
	slugs=$(space_slugs)
	if [ -n "$ONLY" ]; then
		one_space "$ONLY"
		return 0
	fi
	if [ -z "$slugs" ]; then
		[ "$DRY" = 1 ] || say "harness: no recorded space to supervise — bin/space new --name <slug> --project <path>"
		return 0
	fi
	while IFS= read -r slug; do
		[ -n "$slug" ] || continue
		one_space "$slug"
	done <<<"$slugs"
}

while :; do
	pass
	[ "$ONCE" = 1 ] && break
	sleep "$INTERVAL"
done
exit 0
