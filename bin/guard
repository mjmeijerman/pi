#!/usr/bin/env bash
# guard — the supervisor for durable spaces.
#
# bash is resolved at runtime, before anything else runs: see bin/shell-resolve.sh. It re-execs this
# script under a bash it finds when the shell that started it is not bash (cmd.exe, PowerShell, or a
# minimal Git Bash with only sh.exe), and says so when there is none.
# shellcheck source=bin/shell-resolve.sh
shell_dir=$(dirname -- "$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")")
if [ -f "$shell_dir/shell-resolve.sh" ]; then
	. "$shell_dir/shell-resolve.sh"
elif [ -z "${BASH_VERSION:-}" ]; then
	printf '%s: no shell-resolve.sh next to %s — it is what finds bash: set PI_GIT_BASH or run this under bash\n' "${0##*/}" "$0" >&2
	exit 127
fi
#
# A durable space is recorded (`state/spaces/<slug>/space.json`, written by `bin/space new`) and a
# worker is a tab in its boss's space (`kind: "tab"` in `delegations.json`). Nothing puts either
# back after it vanishes: Herdr has no per-space lock, `space.close` ends a space and its
# terminals, and a host reboot hands the tabs back as plain shells. So the space is made
# self-healing here instead — the same idea `~/big-boss-pi/bin/guard` proved while there was one
# space, now driven by the records rather than by one hardcoded name.
#
# Every pass, for every recorded space:
#
#   1. the space is gone from `herdr-app ls` → rebuild it with the record's own name, project
#      folder and Boss tab name, then a `tab.new` for every other tab the record lists. Never a new
#      space name, never a new project folder: the record is what the person wrote down.
#   2. the space is there but its Boss tab is not → respawn that tab. If a resume entry names a
#      session for the terminal it used to have (`~/.pi/agent/herdr-resume/<terminal>.json`),
#      the tab is started with `<entry argv> --session <path>`: the same conversation, the same
#      entry `scripts/herdr-resume.mjs` reads, and the guard types nothing into a terminal itself.
#      A tab that is there is left alone — that is the "never type twice in one boot" rule, kept
#      by not typing at all.
#   3. a worker's tab is not the guard's business: a slug in the space's `delegations.json` is
#      resurrected only by `delegate wait --forever`, so a finished worker's tab stays closed and a
#      recorded tab carrying a worker's name is never opened here.
#   4. nothing is ever closed, renamed or moved. A supervisor that closes things is a machine that
#      deletes someone's work, so `space.close`, `tab.close`, `space.move` and any rename are not
#      words this program knows; `scripts/tests/test-guard-supervisor.sh` asserts it on the argv a
#      stub `herdr-app` saw.
#   5. a space whose project folder is gone is reported by name and skipped: a space on a missing
#      folder would put the boss in a folder `git` cannot resolve. The refusal carries the command
#      that fixes it, `bin/space forget <slug>`.
#   6. a forgotten space is left alone, and so is a space in Herdr with no record — it may be
#      somebody's scratch space, and recreating what nobody recorded is how a program starts making
#      spaces for people.
#
# The record gains one field, `tabs`: the Boss tab plus any extra tab the supervisor re-created,
# each `{name, folder, argv}`. `bin/space` keeps writing only what it writes today; this is a plain
# addition, and it is the only file the guard ever writes.
#
# The app is asked once per pass (`herdr-app ls`), every action is one line, and `--once` runs
# exactly one pass so a test costs a second. It runs under `env -i` with `PATH` and `HOME` because
# the runner and the sandbox both do: no git config, no login shell, no caller's environment.
#
# Radar Vol. 35: blip 20 (stateful guardrails) — a rule nothing checks is a rule that is gone.
set -uo pipefail

here=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)
# shellcheck source=bin/space-lib.sh
. "$here/space-lib.sh"

prog=guard
INTERVAL=${PI_GUARD_INTERVAL:-20}
HERDR_APP=${PI_GUARD_HERDR_APP:-herdr-app}
RESUME_DIR=${PI_HERDR_RESUME_DIR:-${HOME:-}/.pi/agent/herdr-resume}
RESUME_SCRIPT=${PI_GUARD_RESUME_SCRIPT:-${HOME:-}/.pi/scripts/herdr-resume.mjs}
ONCE=0
DRY=0
ONLY=""

say() { printf '%s: %s\n' "$prog" "$*"; }

usage() {
	cat >&2 <<'EOF'
usage: bin/guard [--once] [--space <slug>] [--dry-run]

  (no argument)   supervise every recorded space, one pass every 20 seconds
  --once          run exactly one pass and exit (what the tests call)
  --space <slug>  limit a pass to one space
  --dry-run       print the plan and call no herdr-app at all
EOF
	exit 1
}

while [ "$#" -gt 0 ]; do
	case $1 in
	--once) ONCE=1; shift ;;
	--dry-run) DRY=1; shift ;;
	--space) ONLY=${2:-}; shift 2 ;;
	-h | --help | help) usage ;;
	*) usage ;;
	esac
done
[ -z "$ONLY" ] || space_valid_slug "$ONLY" || usage

# field_of <key> — read one scalar field from the JSON on stdin.
field_of() {
	node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{let j={};try{j=JSON.parse(d)}catch{};const v=j[process.argv[1]];if(v!==undefined&&v!==null&&typeof v!=="object")process.stdout.write(String(v))})' "${1:-}"
}

# space_state <name> [id] — this pass's snapshot entry for that space: `none` when Herdr does not list
# it, else `{"id":...,"tabs":[...]}` (tabs is null when the app answered without a tab list, which
# is "cannot tell", not "no tabs").
#
# The name is the record's handle and the id is herdr's, so both are tried: a person who renames the
# space in the app still has a record naming that id, and rebuilding on the old name would leave two
# spaces for one project — which is the one thing a space exists to prevent.
space_state() {
	printf '%s' "$SNAP" | HERDR_SPACE_NAME=${1:-} HERDR_SPACE_ID=${2:-} node -e '
		let d = "";
		process.stdin.on("data", (c) => (d += c)).on("end", () => {
			let j = {};
			try { j = JSON.parse(d); } catch { process.stdout.write("none"); return; }
			const spaces = Array.isArray(j.spaces) ? j.spaces : [];
			const id = process.env.HERDR_SPACE_ID || "";
			const hit =
				spaces.find((s) => s && s.name === process.env.HERDR_SPACE_NAME) ||
				(id ? spaces.find((s) => s && String(s.id ?? "") === id) : undefined);
			if (!hit) { process.stdout.write("none"); return; }
			process.stdout.write(JSON.stringify({ id: String(hit.id ?? ""), tabs: Array.isArray(hit.tabs) ? hit.tabs : null }));
		});'
}

# boss_present <slug> — is the record's Boss tab in this space? stdin is `space_state`'s answer.
#   yes     the tab is there (by its name, or by a terminal the record names
#   no      the space has tabs and none of them is the Boss tab
#   unknown the app answered with no tab list, or with tabs whose names and ids say nothing:
#           a guard that guesses here re-opens the Boss tab every 20 seconds forever
boss_present() {
	RECORD=$(space_record "${1:-}") node -e '
		const fs = require("fs");
		let d = "";
		process.stdin.on("data", (c) => (d += c)).on("end", () => {
			let s = {};
			try { s = JSON.parse(d); } catch { process.stdout.write("unknown"); return; }
			let r = {};
			try { r = JSON.parse(fs.readFileSync(process.env.RECORD, "utf8")); } catch {}
			const boss = String(r.uberboss_tab || "Boss");
			const ids = new Set((Array.isArray(r.terminals) ? r.terminals : []).map(String));
			const tabs = Array.isArray(s.tabs) ? s.tabs : null;
			if (tabs === null) { process.stdout.write("unknown"); return; }
			if (tabs.length === 0) { process.stdout.write("no"); return; }
			let identifiable = false;
			for (const t of tabs) {
				if (!t || typeof t !== "object") continue;
				const name = String(t.name ?? t.title ?? "");
				const own = [t.id, t.tab, t.terminal].filter((v) => typeof v === "string");
				if (Array.isArray(t.terminals)) {
					for (const x of t.terminals) own.push(typeof x === "string" ? x : String(x?.id ?? ""));
				}
				if (name || own.length) identifiable = true;
				if (name && name === boss) { process.stdout.write("yes"); return; }
				if (own.some((v) => ids.has(v))) { process.stdout.write("yes"); return; }
			}
			process.stdout.write(identifiable ? "no" : "unknown");
		});'
}

# resume_entry <slug> — the newest resume entry that belongs to this space's Boss tab, as JSON
# `{session_path, argv}`, or nothing. Read by terminal id first (the entry the extension wrote for
# that tab), then by the space id plus the project folder (after a reboot the parked tab can lose
# its terminal). An entry whose session file is gone is not an answer.
resume_entry() {
	RECORD=$(space_record "${1:-}") RESUME_DIR=$RESUME_DIR node -e '
		const fs = require("fs"), path = require("path");
		let r = {};
		try { r = JSON.parse(fs.readFileSync(process.env.RECORD, "utf8")); } catch { process.exit(0); }
		const ids = new Set((Array.isArray(r.terminals) ? r.terminals : []).map(String));
		let names = [];
		try { names = fs.readdirSync(process.env.RESUME_DIR).filter((n) => n.endsWith(".json")); } catch { process.exit(0); }
		let best = null;
		for (const n of names) {
			let e = {};
			try { e = JSON.parse(fs.readFileSync(path.join(process.env.RESUME_DIR, n), "utf8")); } catch { continue; }
			if (!e || typeof e.session_path !== "string" || !Array.isArray(e.argv) || e.argv.length === 0) continue;
			if (!fs.existsSync(e.session_path)) continue;
			const byTerminal = typeof e.terminal === "string" && ids.has(e.terminal);
			const bySpace = Boolean(r.id) && e.space === r.id && e.cwd === r.project;
			if (!byTerminal && !bySpace) continue;
			const at = String(e.updated_at || "");
			if (!best || at > best.at) best = { at, entry: e };
		}
		if (!best) process.exit(0);
		process.stdout.write(JSON.stringify({ session_path: best.entry.session_path, argv: best.entry.argv }));
	'
}

# record_extras <slug> <boss name> — one TSV line per recorded tab that is not the Boss and not a
# worker: `name<TAB>folder<TAB>argv-json`. A tab named after a slug in `delegations.json` is a
# worker's tab, and a worker's tab is `delegate wait --forever`'s to bring back, not this program's.
record_extras() {
	RECORD=$(space_record "${1:-}") DELEGATIONS=$(space_delegations "${1:-}") node -e '
		const fs = require("fs");
		let r = {};
		try { r = JSON.parse(fs.readFileSync(process.env.RECORD, "utf8")); } catch { process.exit(0); }
		let d = {};
		try { d = JSON.parse(fs.readFileSync(process.env.DELEGATIONS, "utf8")); } catch {}
		const boss = process.argv[1];
		for (const t of Array.isArray(r.tabs) ? r.tabs : []) {
			if (!t || typeof t !== "object") continue;
			const name = String(t.name || "");
			if (!name || name === boss) continue;
			if (d && Object.prototype.hasOwnProperty.call(d, name)) continue;
			const folder = String(t.folder || r.project || "");
			const argv = Array.isArray(t.argv) && t.argv.length ? JSON.stringify(t.argv) : "";
			process.stdout.write([name, folder, argv].join("\t") + "\n");
		}
	' "${2:-Boss}"
}

# record_tabs_seed <slug> — give a record written before this field existed its `tabs` list, once.
# A plain addition: every other field is left exactly as `bin/space` wrote it.
record_tabs_seed() {
	RECORD=$(space_record "${1:-}") node -e '
		const fs = require("fs");
		let r = {};
		try { r = JSON.parse(fs.readFileSync(process.env.RECORD, "utf8")); } catch { process.exit(0); }
		if (Array.isArray(r.tabs) && r.tabs.length) process.exit(0);
		r.tabs = [{ name: String(r.uberboss_tab || "Boss"), folder: String(r.project || ""), argv: [] }];
		fs.writeFileSync(process.env.RECORD, JSON.stringify(r, null, 2) + "\n");
	'
}

# boss_argv <slug> <boss name> — the argv the record kept for the Boss tab, or nothing.
boss_argv() {
	RECORD=$(space_record "${1:-}") node -e '
		const fs = require("fs");
		let r = {};
		try { r = JSON.parse(fs.readFileSync(process.env.RECORD, "utf8")); } catch { process.exit(0); }
		const want = process.argv[1];
		const hit = (Array.isArray(r.tabs) ? r.tabs : []).find((t) => t && t.name === want);
		if (hit && Array.isArray(hit.argv) && hit.argv.length) process.stdout.write(JSON.stringify(hit.argv));
	' "${2:-Boss}"
}

# record_boss_tab <slug> [argv-json] — remember the Boss tab the supervisor just opened, so the
# next rebuild starts it the same way.
record_boss_tab() {
	RECORD=$(space_record "${1:-}") BOSS_ARGV=${2:-} node -e '
		const fs = require("fs");
		let r = {};
		try { r = JSON.parse(fs.readFileSync(process.env.RECORD, "utf8")); } catch { process.exit(0); }
		const name = String(r.uberboss_tab || "Boss");
		let argv = [];
		try { argv = JSON.parse(process.env.BOSS_ARGV || "[]"); } catch {}
		const tabs = Array.isArray(r.tabs) ? r.tabs : [];
		const entry = { name, folder: String(r.project || ""), argv: Array.isArray(argv) ? argv : [] };
		const at = tabs.findIndex((t) => t && t.name === name);
		if (at < 0) tabs.push(entry);
		else tabs[at] = entry;
		r.tabs = tabs;
		fs.writeFileSync(process.env.RECORD, JSON.stringify(r, null, 2) + "\n");
	'
}

# tab_new <space id> <name> <folder> [argv-json] — the one way this program opens a tab. No colour
# of close, no rename, no move: the app is only ever asked to add.
tab_new() {
	local sid=${1:-} tname=${2:-} folder=${3:-} argv=${4:-}
	if [ -n "$argv" ]; then
		"$HERDR_APP" do tab.new --name "$tname" --space "$sid" --folder "$folder" --argv "$argv"
	else
		"$HERDR_APP" do tab.new --name "$tname" --space "$sid" --folder "$folder"
	fi
}

# resume_sweep — after a space was rebuilt, let `scripts/herdr-resume.mjs` put back whatever parked
# terminal it can. Not reimplemented here: that script owns the typing, the "already restored this
# boot" mark and the pruning, and a second copy of those rules is how two programs start disagreeing
# about whether a session is already running.
resume_sweep() {
	local out
	[ -f "$RESUME_SCRIPT" ] || return 0
	command -v node >/dev/null 2>&1 || return 0
	out=$(PI_HERDR_RESUME_WAIT_MS=${PI_GUARD_RESUME_WAIT_MS:-1500} \
		PI_HERDR_RESUME_ENTRY_MS=${PI_GUARD_RESUME_ENTRY_MS:-2000} \
		PI_HERDR_RESUME_START_MS=${PI_GUARD_RESUME_START_MS:-2000} \
		node "$RESUME_SCRIPT" 2>&1) || true
	case $out in
	*"restored terminal "*) say "harness: herdr-resume restored $(printf '%s\n' "$out" | grep -c 'restored terminal ') session(s)" ;;
	esac
}

# rebuild_space <slug> <name> <boss> — the space itself is gone: make it again exactly as the
# record says, then the tabs the record lists.
rebuild_space() {
	local slug=$1 name=$2 boss=$3 project out spaceid extras tname tfolder targv count
	project=$(space_field "$slug" project)
	extras=$(record_extras "$slug" "$boss")
	count=1
	[ -z "$extras" ] || count=$((1 + $(printf '%s\n' "$extras" | grep -c .)))
	out=$("$HERDR_APP" do space.new --name "$name" --folder "$project" --tab "$boss" 2>&1) || {
		say "harness: space.new failed for $name: $out"
		return 0
	}
	say "harness: space gone, recreating with $count tabs"
	spaceid=$(printf '%s' "$out" | field_of space)
	# The Boss tab `space.new` just opened runs the app's default, so an empty argv is the truth.
	record_boss_tab "$slug" ""
	if [ -n "$extras" ]; then
		while IFS=$'\t' read -r tname tfolder targv; do
			[ -n "$tname" ] || continue
			[ -n "$tfolder" ] || tfolder=$project
			if [ -n "$spaceid" ] && tab_new "$spaceid" "$tname" "$tfolder" "$targv" >/dev/null 2>&1; then
				say "harness: tab $tname recreated in $name"
			else
				say "harness: tab.new failed for $tname in $name"
			fi
		done <<<"$extras"
	fi
	resume_sweep
}

# restore_boss <slug> <name> <boss> <space> — the space is there and its Boss tab is not.
restore_boss() {
	local slug=$1 name=$2 boss=$3 space="$4" project spaceid entry argv sessionpath
	project=$(space_field "$slug" project)
	spaceid=$(printf '%s' "$space" | field_of id)
	entry=$(resume_entry "$slug")
	if [ -n "$entry" ]; then
		argv=$(printf '%s' "$entry" | RESUME_ENTRY=$entry node -e '
			const e = JSON.parse(process.env.RESUME_ENTRY);
			process.stdout.write(JSON.stringify([...e.argv, "--session", e.session_path]));')
		sessionpath=$(printf '%s' "$entry" | field_of session_path)
		if tab_new "$spaceid" "$boss" "$project" "$argv" >/dev/null 2>&1; then
			say "harness: Boss tab resumed from session $sessionpath"
			record_boss_tab "$slug" "$argv"
			return 0
		fi
		say "harness: tab.new failed for the Boss tab of $name"
		return 0
	fi
	# No session to put back: open the tab with the argv the record kept for it.
	argv=$(boss_argv "$slug" "$boss")
	if tab_new "$spaceid" "$boss" "$project" "$argv" >/dev/null 2>&1; then
		say "harness: Boss tab recreated in $name, no session to resume"
		record_boss_tab "$slug" "$argv"
	else
		say "harness: tab.new failed for the Boss tab of $name"
	fi
}

# one_space <slug> — everything one pass does about one space.
one_space() {
	local slug=$1 name project boss space present
	if ! space_exists "$slug"; then
		say "$slug: no record, left alone — bin/space list"
		return 0
	fi
	name=$(space_field "$slug" name)
	[ -n "$name" ] || name=$slug
	boss=$(space_field "$slug" uberboss_tab)
	[ -n "$boss" ] || boss=Boss
	project=$(space_field "$slug" project)
	if [ -z "$project" ] || [ ! -d "$project" ]; then
		say "$name: project folder is gone, skipped — bin/space forget $slug if you mean it"
		return 0
	fi
	if [ "$DRY" = 1 ]; then
		say "$name: dry-run: would keep space '$name' on $project with its recorded tabs"
		return 0
	fi
	record_tabs_seed "$slug"
	space=$(space_state "$name" "$(space_field "$slug" id)")
	if [ "$space" = none ]; then
		rebuild_space "$slug" "$name" "$boss"
		return 0
	fi
	present=$(printf '%s' "$space" | boss_present "$slug")
	case $present in
	yes) return 0 ;;
	unknown)
		say "$name: herdr-app listed no tab names or ids for it, left alone"
		return 0
		;;
	esac
	restore_boss "$slug" "$name" "$boss" "$space"
}

# pass — one sweep over the records, with the app asked once.
pass() {
	local slugs slug
	if command -v "$HERDR_APP" >/dev/null 2>&1; then
		SNAP=$("$HERDR_APP" ls 2>/dev/null) || SNAP=""
	else
		SNAP=""
	fi
	if [ "$DRY" = 0 ] && [ -z "$SNAP" ]; then
		say "harness: herdr-app did not answer, so no space can be supervised — is the app running?"
		return 0
	fi
	slugs=$(space_slugs)
	if [ -n "$ONLY" ]; then
		one_space "$ONLY"
		return 0
	fi
	if [ -z "$slugs" ]; then
		[ "$DRY" = 1 ] || say "harness: no recorded space to supervise — bin/space new --name <slug> --project <path>"
		return 0
	fi
	while IFS= read -r slug; do
		[ -n "$slug" ] || continue
		one_space "$slug"
	done <<<"$slugs"
}

while :; do
	pass
	[ "$ONCE" = 1 ] && break
	sleep "$INTERVAL"
done
exit 0
