#!/usr/bin/env bash
# pi global git hook wrapper — generated by install-hooks.sh, do not edit
set -u
HOOK_NAME="post-applypatch"
HOOKS_HOME="${PI_GIT_HOOKS_DIR:-/tmp/regen-hooks}"
GIT_DIR="$(git rev-parse --git-common-dir 2>/dev/null || echo .git)"
REPO_HOOK="$GIT_DIR/hooks/$HOOK_NAME"
if [ -x "$REPO_HOOK" ] && [ "$REPO_HOOK" != "$0" ]; then
	"$REPO_HOOK" "$@" || exit $?
fi
case "$HOOK_NAME" in
pre-commit)
	# Harness budgets first (milliseconds), then the hidden-codepoint scan,
	# then the secret scan, which must still run and still be the thing that
	# decides the commit's fate. A skill or a prompt arrives from elsewhere, so
	# its bytes are scanned before they are read as instruction (blip #72, blip #7).
	if [ -x "$HOOKS_HOME/harness-pre-commit" ]; then
		"$HOOKS_HOME/harness-pre-commit" "$@" || exit $?
	fi
	if [ -x "$HOOKS_HOME/scan-unicode.sh" ]; then
		"$HOOKS_HOME/scan-unicode.sh" "$@" || exit $?
	fi
	exec "$HOOKS_HOME/scan-secrets.sh"
	;;
commit-msg)
	# Secret scan first — it decides whether the commit happens at all — then
	# the provenance trailers, appended while the message is still a file.
	"$HOOKS_HOME/scan-commitmsg.sh" "$1" || exit $?
	exec "$HOOKS_HOME/add-provenance.sh" "$1"
	;;
pre-push) exec "$HOOKS_HOME/scan-prepush.sh" ;;
esac
exit 0
