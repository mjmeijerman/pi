{
  "lastChangelogVersion": "1.6.1",
  "theme": "dark",
  "enableSkillCommands": true,
  "defaultTools": [
    "+codemode"
  ],
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-flash",
  "packages": [
    "https://github.com/ayghri/i-have-adhd",
    "npm:pi-web-access",
    "git:https://github.com/michielpapenhove/pi-observational-memory.git",
    "git:github.com/michielpapenhove/pi-prompt-snippets"
  ],
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.48.0",
    "{\"source\":\"git:github.com/michielpapenhove/pi-prompt-snippets\",\"scope\":\"user\"}": "0.1.0"
  },
  "hideThinkingBlock": true,
  "observational-memory": {
    "compactAtContextTokens": 120000,
    "tailTokens": 20000,
    "maxTailTokens": 40000,
    "debugLog": false,
    "models": {
      "observer": {
        "provider": "deepseek",
        "id": "deepseek-flash",
        "thinking": "medium"
      },
      "consolidator": {
        "provider": "deepseek",
        "id": "deepseek-flash",
        "thinking": "high"
      }
    }
  }
}