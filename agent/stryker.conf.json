{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing (Thoughtworks Radar Vol. 35, blip 2, Adopt). Proves the extension assertions actually bite. First pass is scoped to the non-TUI modules so a run finishes in minutes; `command` runs the same `npm test` the CI job runs.",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test \"extensions/__tests__/*.test.ts\""
  },
  "mutate": [
    "extensions/lib/**/*.ts",
    "extensions/merge-guard.ts",
    "extensions/secret-guard.ts",
    "!extensions/**/*.test.ts"
  ],
  "ignorePatterns": [
    "reports/**",
    "node_modules/**",
    "sessions/**",
    "*.log",
    "dictation/venv/**",
    "**/venv/**",
    "**/lib64/**",
    ".stryker-tmp/**"
  ],
  "incremental": true,
  "incrementalFile": "reports/stryker/stryker-incremental.json",
  "timeoutMS": 60000,
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/stryker/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/stryker/mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  }
}
