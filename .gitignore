# pi agent state — never in git
agent/sessions/
agent/auth.json
agent/models-store.json
agent/bin/
agent/dictation/recording.wav
agent/dictation/venv/
# The wizard's answers: ~/.pi/state/setup.json; re-running with --reask starts over.
# A fresh install used to leave this folder untracked in the repo it just cloned.
state/

# IDE
.idea/

# installed packages and runtime state
agent/node_modules/
agent/git/
agent/npm/
agent/pi-web-access/
agent/web-search-cache/
agent/secret-guard.log

# mutation testing artifacts (Radar Vol. 35, blip 2) — regenerated by `make mutate`
agent/reports/stryker/
agent/.stryker-tmp/

# secrets and local scratch — never in git
agent/deepseek.key
agent/suggestions.jsonl
agent/retro/
# eval run state: `make evals` writes these, harness-check.sh reads last-run.txt.
# Local on purpose — a fresh clone reports "no eval run recorded" instead of
# inheriting someone else's pass count.
agent/evals/last-run.txt
agent/evals/.last-run.json
# Learner output: a proposal is a review artefact, not harness code.
agent/proposals/
scripts/.agent-panes.json
# Resume map: one file per hc terminal, rewritten as sessions run, plus the
# restore log. Machine state, not harness code (agent/extensions/herdr-resume-map.ts).
agent/herdr-resume/
*.bak
werken-met-ai.pdf
agent/env.secret
# Worker checkouts: `git worktree add .worktrees/SLUG` must sit inside the repo
# (the sandbox binds the repo, not its parent), so it is scratch, not harness code.
.worktrees/

.pi/
herdr-mods/durable/gpui-kit.d.ts
